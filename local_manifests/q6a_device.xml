<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!--
    The mainline device tree path for the Radxa Dragon Q6A (LineageOS 24 / Android 17).
    Added by hand, because roomservice.py in depsonly mode looks for the tree by repo
    name in local_manifests (regex android_device_.*_generic$), and the third-parameter
    patch described in docs/build.md DOES NOT EXIST: Gerrit 492595 was abandoned on
    2026-08-15. The dependencies (device/mainline/common, tinyhal,
    kernel/mainline/configs, bootmgr, mesa, drm_hwcomposer-upstream, minigbm-upstream,
    linux-firmware-mainline, hardware/mainline/common) are fetched by roomservice itself.
  -->
  <project path="device/mainline/generic" name="LineageOS/android_device_mainline_generic" />
</manifest>
