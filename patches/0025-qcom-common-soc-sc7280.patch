+genfscon sysfs /devices/platform/soc@0/4080000.remoteproc/remoteproc/remoteproc		u:object_r:vendor_sysfs_remoteproc:s0
+genfscon sysfs /devices/platform/soc@0/8a00000.remoteproc/remoteproc/remoteproc		u:object_r:vendor_sysfs_remoteproc:s0
+genfscon sysfs /devices/platform/soc@0/a300000.remoteproc/remoteproc/remoteproc		u:object_r:vendor_sysfs_remoteproc:s0
+
+# USB
+genfscon sysfs /devices/platform/soc@0/a600000.usb/udc/a600000.usb	u:object_r:sysfs_udc:s0
