diff --git a/soc/sc7280/init/init.mainline.qcom.sc7280.rc b/soc/sc7280/init/init.mainline.qcom.sc7280.rc
new file mode 100644
index 0000000..78f0a88
--- /dev/null
+++ b/soc/sc7280/init/init.mainline.qcom.sc7280.rc
@@ -0,0 +1,10 @@
+#
+# SPDX-FileCopyrightText: The LineageOS Project
+# SPDX-License-Identifier: Apache-2.0
+#
+
+# Cpuset
+# CPUs 0-3 are the Cortex-A55 cluster.
+on boot
+    write /dev/cpuset/background/cpus 0-3
+    write /dev/cpuset/system-background/cpus 0-3
diff --git a/soc/sc7280/product.mk b/soc/sc7280/product.mk
new file mode 100644
index 0000000..875e941
--- /dev/null
+++ b/soc/sc7280/product.mk
@@ -0,0 +1,29 @@
+#
+# SPDX-FileCopyrightText: The LineageOS Project
+# SPDX-License-Identifier: Apache-2.0
+#
+
+# Graphics (Mesa)
+# Turnip reports Vulkan 1.3 on Adreno 643; dEQP has not been run, so level 0 for now.
+ifeq ($(TARGET_GRAPHICS),mesa)
+PRODUCT_COPY_FILES += \
+    frameworks/native/data/etc/android.hardware.opengles.aep.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.opengles.aep.xml \
+    frameworks/native/data/etc/android.hardware.vulkan.level-0.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.vulkan.level.xml \
+    frameworks/native/data/etc/android.hardware.vulkan.version-1_3.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.vulkan.version.xml
+endif
+
+# Graphics allocator (minigbm)
+$(call soong_config_set_string_list,minigbm_upstream,cflags,-DSC_7280)
+
+# Init
+PRODUCT_PACKAGES += \
+    init.mainline.qcom.sc7280.rc
+
+# Media
+ifeq ($(TARGET_MEDIA_C2_HAL),v4l2_codec2)
+PRODUCT_VENDOR_PROPERTIES += \
+    ro.vendor.v4l2_codec2.decoder.supported.h264=true \
+    ro.vendor.v4l2_codec2.decoder.supported.hevc=true \
+    ro.vendor.v4l2_codec2.decoder.supported.vp9=true \
+    ro.vendor.v4l2_codec2.encoder.supported.h264=true
+endif # TARGET_MEDIA_C2_HAL
diff --git a/soc/sc7280/sepolicy/vendor/genfs_contexts b/soc/sc7280/sepolicy/vendor/genfs_contexts
