diff --git a/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts b/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts
index 0773efd2f3e8..4f4977cdac11 100644
--- a/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts
+++ b/arch/arm64/boot/dts/qcom/qcs6490-radxa-dragon-q6a.dts
@@ -111,6 +111,31 @@ usb2_3_connector: endpoint {
 		};
 	};
 
+	usb3_con: connector-3 {
+		compatible = "usb-a-connector";
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+
+				usb3_con_hs_in: endpoint {
+					remote-endpoint = <&usb_1_dwc3_hs>;
+				};
+			};
+
+			port@1 {
+				reg = <1>;
+
+				usb3_con_ss_in: endpoint {
+					remote-endpoint = <&usb_dp_qmpphy_out_usb>;
+				};
+			};
+		};
+	};
+
 	/*
 	 * The DisplayPort output of the SoC is routed to the HDMI type A
 	 * connector through an RA620 DP-to-HDMI level shifter.
@@ -1057,6 +1082,10 @@ &usb_1 {
 	status = "okay";
 };
 
+&usb_1_dwc3_hs {
+	remote-endpoint = <&usb3_con_hs_in>;
+};
+
 &usb_1_hsphy {
 	vdda-pll-supply = <&vreg_l10c_0p88>;
 	vdda33-supply = <&vreg_l2b_3p072>;
@@ -1091,10 +1120,27 @@ &usb_1_qmpphy {
 
 	ports {
 		port@0 {
-			endpoint {
-				/* DP on lanes 0,1 => TYPEC_ORIENTATION_REVERSE */
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			/delete-node/ endpoint;
+
+			/* DP on lanes 0,1 => TYPEC_ORIENTATION_REVERSE */
+			usb_dp_qmpphy_out: endpoint@0 {
+				reg = <0>;
 				data-lanes = <0 1>;
 			};
+
+			/*
+			 * USB3 SuperSpeed on lanes 2,3, the same orientation. Without this
+			 * endpoint the PHY runs DP only, provides no PIPE clock, and the
+			 * DWC3 core of the USB 3.0 port times out on init.
+			 */
+			usb_dp_qmpphy_out_usb: endpoint@1 {
+				reg = <1>;
+				data-lanes = <2 3>;
+				remote-endpoint = <&usb3_con_ss_in>;
+			};
 		};
 	};
 };
