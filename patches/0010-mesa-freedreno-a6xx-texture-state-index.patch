 static void fd6_texture_state_destroy(struct fd6_texture_state *state);
 
+/*
+ * Reverse map from a tex_ids seqno to the tex_cache entries referencing it.
+ *
+ * Deleting a sampler-view or a sampler-state has to drop every tex_cache
+ * entry whose key mentions its seqno.  The tex_cache is unbounded (it grows
+ * with the number of distinct texture/sampler combinations the application
+ * uses), so scanning all of it per deletion is O(n) with the screen lock
+ * held.  Applications that stream in a lot of textures hit this hard: on a
+ * QCS6490 running Genshin Impact it was ~16% of the process' CPU time, all
+ * of it on the threaded-context driver thread, which the GL frontend then
+ * blocks on in eglSwapBuffers().  Keeping the reverse map makes the lookup
+ * proportional to the number of entries actually affected.
+ */
+
+static struct util_dynarray *
+tex_state_refs(struct fd6_context *fd6_ctx, uint16_t seqno)
+{
+   if (seqno >= fd6_ctx->num_tex_state_refs) {
+      unsigned n = MAX2(256u, util_next_power_of_two(seqno + 1));
+      fd6_ctx->tex_state_refs = (struct util_dynarray *)realloc(
+         fd6_ctx->tex_state_refs, n * sizeof(struct util_dynarray));
+      memset(&fd6_ctx->tex_state_refs[fd6_ctx->num_tex_state_refs], 0,
+             (n - fd6_ctx->num_tex_state_refs) * sizeof(struct util_dynarray));
+      fd6_ctx->num_tex_state_refs = n;
+   }
+
+   return &fd6_ctx->tex_state_refs[seqno];
+}
+
+#define TEX_KEY_NUM_SEQNOS                                                     \
+   (ARRAY_SIZE(((struct fd6_texture_key *)NULL)->view_seqno) +                 \
+    ARRAY_SIZE(((struct fd6_texture_key *)NULL)->samp_seqno))
+
+/* Collect the distinct seqnos a key references.  Unused slots are left as
+ * zero by the caller, and zero is also a seqno util_idalloc can hand out, so
+ * it is collected like any other; that matches what the old full scan did.
+ */
+static unsigned
+tex_key_seqnos(const struct fd6_texture_key *key, uint16_t *out)
+{
+   unsigned n = 0;
+
+   for (unsigned i = 0; i < TEX_KEY_NUM_SEQNOS; i++) {
+      uint16_t seqno = (i < ARRAY_SIZE(key->view_seqno))
+                          ? key->view_seqno[i]
+                          : key->samp_seqno[i - ARRAY_SIZE(key->view_seqno)];
+      bool dup = false;
+
+      for (unsigned j = 0; j < n; j++) {
+         if (out[j] == seqno) {
+            dup = true;
+            break;
+         }
+      }
+
+      if (!dup)
+         out[n++] = seqno;
+   }
+
+   return n;
+}
+
+static void
+tex_state_ref_add(struct fd6_context *fd6_ctx, struct fd6_texture_state *state)
+{
+   uint16_t seqnos[TEX_KEY_NUM_SEQNOS];
+   unsigned n = tex_key_seqnos(&state->key, seqnos);
+
+   for (unsigned i = 0; i < n; i++) {
+      util_dynarray_append_typed(tex_state_refs(fd6_ctx, seqnos[i]),
+                                 struct fd6_texture_state *, state);
+   }
+}
+
+static void
+tex_state_ref_del(struct fd6_context *fd6_ctx, struct fd6_texture_state *state)
+{
+   uint16_t seqnos[TEX_KEY_NUM_SEQNOS];
+   unsigned n = tex_key_seqnos(&state->key, seqnos);
+
+   for (unsigned i = 0; i < n; i++) {
+      struct util_dynarray *refs = tex_state_refs(fd6_ctx, seqnos[i]);
+      unsigned len =
+         util_dynarray_num_elements(refs, struct fd6_texture_state *);
+
+      for (unsigned j = 0; j < len; j++) {
+         struct fd6_texture_state **elem =
+            util_dynarray_element(refs, struct fd6_texture_state *, j);
+
+         if (*elem == state) {
+            *elem = *util_dynarray_element(refs, struct fd6_texture_state *,
+                                           len - 1);
+            (void)util_dynarray_pop(refs, struct fd6_texture_state *);
+            break;
+         }
+      }
+   }
+}
+
 static void
 remove_tex_entry(struct fd6_context *fd6_ctx, struct hash_entry *entry)
 {
    struct fd6_texture_state *tex = (struct fd6_texture_state *)entry->data;
+   tex_state_ref_del(fd6_ctx, tex);
    _mesa_hash_table_remove(fd6_ctx->tex_cache, entry);
    fd6_texture_state_destroy(tex);
 }
 
+/* Drop every tex_cache entry whose key references @seqno. */
+static void
+invalidate_by_seqno(struct fd_context *ctx, uint16_t seqno)
+{
+   struct fd6_context *fd6_ctx = fd6_context(ctx);
+
+   fd_screen_lock(ctx->screen);
+
+   if (seqno < fd6_ctx->num_tex_state_refs) {
+      struct util_dynarray *refs = &fd6_ctx->tex_state_refs[seqno];
+
+      while (util_dynarray_num_elements(refs, struct fd6_texture_state *)) {
+         struct fd6_texture_state *state =
+            *util_dynarray_element(refs, struct fd6_texture_state *, 0);
+         struct hash_entry *entry =
+            _mesa_hash_table_search(fd6_ctx->tex_cache, &state->key);
+
+         assert(entry);
+         /* also drops @state from the dynarray we are walking: */
+         remove_tex_entry(fd6_ctx, entry);
+      }
+   }
+
+   fd_screen_unlock(ctx->screen);
+}
