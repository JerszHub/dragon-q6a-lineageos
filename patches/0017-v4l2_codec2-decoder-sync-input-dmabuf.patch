 namespace {
 
+// Input buffers come from a cached dmabuf heap and Codec2 fills them through a plain mmap, with no
+// DMA_BUF_IOCTL_SYNC. A decoder that does not snoop CPU caches and keeps the buffer mapped between
+// QBUFs then reads stale data. Write the CPU caches back before handing the buffer to the device.
+void syncDmaBufForDevice(int fd) {
+    struct dma_buf_sync sync = {.flags = DMA_BUF_SYNC_START | DMA_BUF_SYNC_WRITE};
+    if (ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync) != 0) {
+        ALOGW("DMA_BUF_IOCTL_SYNC start failed: %d", errno);
+        return;
+    }
+    sync.flags = DMA_BUF_SYNC_END | DMA_BUF_SYNC_WRITE;
+    if (ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync) != 0) {
+        ALOGW("DMA_BUF_IOCTL_SYNC end failed: %d", errno);
+    }
+}
+
 // Extra buffers for transmitting in the whole video pipeline.
