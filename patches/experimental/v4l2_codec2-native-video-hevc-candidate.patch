+    assert(!fits(C2Config::LEVEL_HEVC_MAIN_5,3840,2160,30,40000000));
+    assert(fits(C2Config::LEVEL_HEVC_MAIN_5_1,3840,2160,30,40000000));
+    assert(fits(C2Config::LEVEL_HEVC_MAIN_5_1,3840,2160,64,40000000));
+    assert(!fits(C2Config::LEVEL_HEVC_MAIN_5_1,3840,2160,65,40000000));
+    assert(!fits(C2Config::LEVEL_HEVC_MAIN_1,544,8,1,64000));
+    assert(fits(C2Config::LEVEL_HEVC_MAIN_1,536,8,1,64000));
+    assert(!fits(C2Config::LEVEL_HEVC_MAIN_6_2,0,2160,30,40000000));
+    assert(!fits(C2Config::LEVEL_HEVC_MAIN_6_2,3840,0,30,40000000));
+    assert(!fits(C2Config::LEVEL_HEVC_MAIN_6_2,UINT32_MAX,UINT32_MAX,30,40000000));
+    for(float f:{0.f,-1.f,0.49f,std::numeric_limits<float>::quiet_NaN(),
