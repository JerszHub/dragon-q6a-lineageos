+#!/bin/sh
+# SPDX-License-Identifier: MIT
+set -eu
+
+q6a_hdr_sanitize=0
+q6a_hdr_disable_lsan=0
+for q6a_hdr_option in "$@"; do
+    case "$q6a_hdr_option" in
+        --sanitize) q6a_hdr_sanitize=1 ;;
+        --no-lsan) q6a_hdr_disable_lsan=1 ;;
+        --help)
+            echo "Usage: $0 [--sanitize] [--no-lsan]"
+            echo "--no-lsan disables only LeakSanitizer for restricted host environments."
+            exit 0
+            ;;
+        *) echo "Unknown option: $q6a_hdr_option" >&2; exit 2 ;;
+    esac
+done
+if [ "$q6a_hdr_disable_lsan" = 1 ] && [ "$q6a_hdr_sanitize" != 1 ]; then
+    echo "--no-lsan requires --sanitize" >&2
+    exit 2
+fi
+
+q6a_hdr_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
+q6a_hdr_work=$(mktemp -d "${TMPDIR:-$q6a_hdr_root/tests/host}/q6a-hdr-test.XXXXXXXX")
+trap 'rm -rf -- "$q6a_hdr_work"' EXIT HUP INT TERM
+
+set -- -Wall -Wextra -Werror -I"$q6a_hdr_root/components/include"
+if [ "$q6a_hdr_sanitize" = 1 ]; then
+    set -- "$@" -O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer
+else
+    set -- "$@" -O2
+fi
+"${CC:-cc}" -std=c11 "$@" -c "$q6a_hdr_root/components/HevcHdrSei.c" \
+    -o "$q6a_hdr_work/sei.o"
+
+if [ "$q6a_hdr_disable_lsan" = 1 ]; then
+    # This test-only object does not enter any Android module. Some restricted
+    # sandboxes cannot provide the process inspection LeakSanitizer requires.
+    printf '%s\n' 'extern "C" int __lsan_is_turned_off() { return 1; }' \
+        > "$q6a_hdr_work/lsan-off.cpp"
+    "${CXX:-c++}" -std=c++17 "$@" -c "$q6a_hdr_work/lsan-off.cpp" \
+        -o "$q6a_hdr_work/lsan-off.o"
+    set -- "$@" "$q6a_hdr_work/lsan-off.o"
+fi
+"${CXX:-c++}" -std=c++17 "$@" \
+    "$q6a_hdr_root/components/HevcHdrMetadata.cpp" \
+    "$q6a_hdr_root/tests/host/HevcHdrMetadata_test.cpp" \
+    "$q6a_hdr_work/sei.o" -o "$q6a_hdr_work/test"
+"$q6a_hdr_work/test"
diff --git a/tests/host/run_hevc_level_limits.py b/tests/host/run_hevc_level_limits.py
new file mode 100644
index 0000000..d5dbac5
--- /dev/null
+++ b/tests/host/run_hevc_level_limits.py
@@ -0,0 +1,144 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: MIT
+"""Test the current source's HEVC level math without Android platform headers.
+
+This extracts the actual limit table and helper/getter bodies. Minimal symbolic
+C2 enum/class fixtures provide only the C++ types needed by that pure logic;
+they are not Android ABI declarations or an Android compilation substitute.
+"""
+from __future__ import annotations
+import argparse
+import hashlib
+import os
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+
+def extract(source: str) -> str:
+    start = source.index("constexpr uint32_t kHEVCImplementationMaxFramerate")
+    end = source.index("\n}  // namespace", start)
+    helpers = source[start:end]
+    start = source.index("uint32_t EncodeInterface::getMaxHEVCFramerateForLevel")
+    end = source.index("\n// static\nC2R EncodeInterface::SizeSetter", start)
+    getters = source[start:end]
+    names = list(dict.fromkeys(re.findall(r"C2Config::(LEVEL_HEVC_MAIN_[A-Za-z0-9_]+)", helpers)))
+    if len(names) != 13:
+        raise ValueError("Expected the reviewed thirteen Main-tier levels; inspect changed source before updating fixtures")
+    preamble = '''#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <iterator>
+#include <limits>
+#include <memory>
+#include <cassert>
+#include <iostream>
+// Symbolic test tags only: these numbers are not Android C2 enum/ABI values.
+struct C2Config { enum level_t { LEVEL_UNUSED=-1,''' + ",".join(names) + '''}; };
+'''
+    fixture = '''
+class EncodeInterface {
+public:
+    struct Size { uint32_t width,height; };
+    struct Bitrate { uint32_t value; };
+    std::shared_ptr<Size> mInputVisibleSize;
+    std::shared_ptr<Bitrate> mBitrate;
+    double mHEVCQueriedMaxFramerate=0;
+    uint32_t getMaxHEVCFramerateForLevel(C2Config::level_t level) const;
+    static uint8_t getHEVCLevelIdc(C2Config::level_t level);
+};
+'''
+    return preamble + helpers + fixture + getters + TESTS
+
+
+TESTS = r'''
+// LeakSanitizer cannot enumerate proc tasks in some sandboxes. Address and
+// undefined-behavior sanitizers remain enabled by the default runner.
+extern "C" const char* __asan_default_options() { return "detect_leaks=0"; }
+int main() {
+    auto level=[](C2Config::level_t tag)->const HEVCMainLevelLimit& {
+        for (const auto& item:kHEVCMainLevelLimits) if(item.level==tag) return item;
