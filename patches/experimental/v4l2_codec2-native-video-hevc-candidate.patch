 SupportedCapabilities V4L2Device::queryEncodingCapabilities(VideoCodec codec) {
     SupportedCapabilities caps;
     caps.codec = codec;
+    if (codec == VideoCodec::HEVC) {
+        // Query the same first HEVC encoder that open() will select. Do not
+        // reuse decoder fallback profiles/levels or combine unrelated devices.
+        scoped_refptr<V4L2Device> device = V4L2Device::create();
+        if (!device->open(Type::kEncoder, V4L2_PIX_FMT_HEVC)) {
+            ALOGE("No HEVC encoder available for capability queries");
+            return caps;
