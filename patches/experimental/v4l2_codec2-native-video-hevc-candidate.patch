+// SPDX-License-Identifier: MIT
+#ifndef ANDROID_V4L2_CODEC2_COMMON_COLOR_CONVERSION_H
+#define ANDROID_V4L2_CODEC2_COMMON_COLOR_CONVERSION_H
+
+#include <cstdint>
+
+namespace android {
+
+// Convert interleaved R,G,B,A bytes to planar I420 using the native Q6A fixed
+// BT.709 limited-range formula. Alpha is ignored. Chroma uses a 2x2 box average;
+// odd final columns/rows duplicate their visible edge. Width is 1..8192 and
+// absolute height is 1..8192; negative height flips the source vertically.
+//
+// Each pointer must span its visible rows using the supplied signed stride.
+// Absolute strides must cover width*4, width, ceil(width/2), ceil(width/2)
+// bytes respectively. All four plane footprints must be disjoint. Negative
+// strides point at the last physical row. Padding is never read or written.
+// Returns 0 on success, -1 for invalid geometry/strides/overlap. Invalid inputs
+// do not modify any output. The caller owns the actual mapped buffer sizes.
+int rgbaToI420BT709Limited(const uint8_t* src, int srcStride,
+                          uint8_t* dstY, int strideY,
+                          uint8_t* dstU, int strideU,
+                          uint8_t* dstV, int strideV,
+                          int width, int height);
+
+}  // namespace android
+#endif
