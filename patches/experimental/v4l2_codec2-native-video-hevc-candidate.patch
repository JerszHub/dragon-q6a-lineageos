diff --git a/components/include/v4l2_codec2/components/HevcHdrMetadata.h b/components/include/v4l2_codec2/components/HevcHdrMetadata.h
new file mode 100644
index 0000000..3acb6ce
--- /dev/null
+++ b/components/include/v4l2_codec2/components/HevcHdrMetadata.h
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: MIT
+// Parsed HEVC metadata is snapshotted at input, never looked up from a later
+// mutable stream state when the decoder returns reordered output frames.
+#ifndef ANDROID_V4L2_CODEC2_COMPONENTS_HEVC_HDR_METADATA_H
+#define ANDROID_V4L2_CODEC2_COMPONENTS_HEVC_HDR_METADATA_H
+
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <optional>
+
+#include <v4l2_codec2/components/HevcHdrSei.h>
+
+namespace android {
+
+class HevcHdrMetadata {
+public:
+    // Bound bookkeeping even if a broken decoder never completes its works.
+    static constexpr size_t kMaxSnapshots = 512;
+
+    // Return false only on duplicate IDs or the bookkeeping bound. Malformed
+    // or unknown framing does not alter the last valid stream metadata; the
+    // codec still owns bitstream-error handling. |parseResult| is diagnostic.
+    bool recordInput(int32_t bitstreamId, const uint8_t* data, size_t size,
+                     bool codecConfig, int* parseResult);
+    std::optional<q6a_hdr_c2_payload> snapshot(int32_t bitstreamId) const;
+    void forget(int32_t bitstreamId);
+    void reset();
+    size_t pendingSnapshots() const { return mSnapshots.size(); }
+
+private:
+    q6a_hdr_state mCoded{};
+    unsigned mLengthBytes = 0;
+    bool mSawPictureInput = false;
+    std::map<int32_t, std::optional<q6a_hdr_c2_payload>> mSnapshots;
+};
+
+}  // namespace android
+#endif
diff --git a/components/include/v4l2_codec2/components/HevcHdrSei.h b/components/include/v4l2_codec2/components/HevcHdrSei.h
new file mode 100644
index 0000000..6a0c02e
--- /dev/null
+++ b/components/include/v4l2_codec2/components/HevcHdrSei.h
@@ -0,0 +1,97 @@
+/* SPDX-License-Identifier: MIT
+ * Bounded HEVC HDR10 SEI parsing. No allocation, libc, Android, or SDK needed.
+ *
+ * The caller owns one state per coded video stream and MUST reset it at a
+ * new stream/decoder reset. Successful parses retain previously signalled
+ * fields of the same stream. A malformed input never partially changes state.
+ */
+#ifndef Q6A_HDR_SEI_H
+#define Q6A_HDR_SEI_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef __UINT8_TYPE__ q6a_hdr_u8;
+typedef __UINT16_TYPE__ q6a_hdr_u16;
+typedef __UINT32_TYPE__ q6a_hdr_u32;
+typedef __UINT64_TYPE__ q6a_hdr_u64;
+typedef __SIZE_TYPE__ q6a_hdr_size;
+
+#define Q6A_HDR_MDCV 1U
+#define Q6A_HDR_CLLI 2U
+#define Q6A_HDR_MAX_INPUT (16U * 1024U * 1024U)
+#define Q6A_HDR_MAX_NALS 512U
+#define Q6A_HDR_MAX_MESSAGES 1024U
+
+enum q6a_hdr_format {
+    Q6A_HDR_ANNEX_B = 1,
+    Q6A_HDR_LENGTH_PREFIXED = 2,
+    Q6A_HDR_HVCC = 3
+};
+
+enum q6a_hdr_error {
+    Q6A_HDR_BAD_ARGUMENT = -1,
+    Q6A_HDR_LIMIT = -2,
+    Q6A_HDR_MALFORMED = -3,
+    Q6A_HDR_RANGE = -4
+};
+
+typedef struct q6a_hdr_state {
+    /* HEVC mastering_display_colour_volume order: G, B, R. Units: 1/50000. */
+    q6a_hdr_u16 primary_x[3];
+    q6a_hdr_u16 primary_y[3];
+    q6a_hdr_u16 white_x;
+    q6a_hdr_u16 white_y;
+    /* Both raw HEVC luminances use 1/10000 cd/m^2. */
+    q6a_hdr_u32 max_luminance;
+    q6a_hdr_u32 min_luminance;
+    /* Whole cd/m^2; zero is retained, never invented from mastering values. */
+    q6a_hdr_u16 max_cll;
+    q6a_hdr_u16 max_fall;
+    q6a_hdr_u32 present;
+} q6a_hdr_state;
+
+typedef struct q6a_hdr_c2_payload {
+    /* C2HdrStaticMetadataStruct payload order. All luminances are cd/m^2. */
+    float red_x, red_y;
+    float green_x, green_y;
+    float blue_x, blue_y;
+    float white_x, white_y;
+    float max_luminance, min_luminance, max_cll, max_fall;
+} q6a_hdr_c2_payload;
+
+void q6a_hdr_reset(q6a_hdr_state *state);
+
+/*
+ * Return the OR of Q6A_HDR_MDCV/Q6A_HDR_CLLI found in this input, zero when
+ * absent, or a negative error. State commits only after the entire input is
+ * valid. Header syntax is checked for every NAL; HDR SEIs are read only from
+ * base-layer prefix/suffix SEI NALs (39/40). Other valid NALs are left alone.
+ *
+ * length_bytes must be 1..4 only for LENGTH_PREFIXED and zero otherwise.
+ * Annex B permits 3/4-byte start codes and leading/trailing zero bytes.
+ * hvcC parses the ISO/IEC 14496-15 configuration record and every NAL array.
+ * Fragmented NALs must be reassembled by the caller before parsing.
+ */
+int q6a_hdr_parse(const q6a_hdr_u8 *data, q6a_hdr_size size,
+                  enum q6a_hdr_format format, unsigned length_bytes,
+                  q6a_hdr_state *state);
+
+/*
+ * Emit a public Android hdr-static-info descriptor: type byte 0, then 12
+ * little-endian uint16 fields in R/G/B/white order. Max luminance is rounded
+ * to whole cd/m^2; minimum retains HEVC 1/10000 units. Return 1 when emitted,
+ * 0 if no static fields were signalled, or a negative error. No clamping.
+ * Invalid/unrepresentable values leave the destination untouched.
+ */
+int q6a_hdr_to_descriptor(const q6a_hdr_state *state, q6a_hdr_u8 out[25]);
+
+/* Emit only the 48-byte C2 struct payload, not a guessed C2Param header. */
+int q6a_hdr_to_c2(const q6a_hdr_state *state, q6a_hdr_c2_payload *out);
+
+#ifdef __cplusplus
+}  // extern "C"
+#endif
+
+#endif
