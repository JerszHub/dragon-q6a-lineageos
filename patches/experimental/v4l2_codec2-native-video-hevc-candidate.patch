+bool V4L2Encoder::refreshHEVCFormats() {
+    auto input = mInputQueue->getFormat();
+    auto output = mOutputQueue->getFormat();
+    if (!input.first || !output.first ||
+        input.first->fmt.pix_mp.pixelformat != V4L2_PIX_FMT_NV12 ||
+        output.first->fmt.pix_mp.pixelformat != V4L2_PIX_FMT_HEVC ||
+        output.first->fmt.pix_mp.num_planes != 1) {
+        ALOGE("Final HEVC queue formats are unavailable or changed unexpectedly");
+        return false;
+    }
+    const auto& raw = input.first->fmt.pix_mp;
+    // Preserve the tested fixed BT.709 limited conversion/signaling contract.
+    // DEFAULT encodings are equivalent only with REC709 and this YUV format.
+    if (raw.colorspace != V4L2_COLORSPACE_REC709 ||
+        (raw.ycbcr_enc != V4L2_YCBCR_ENC_DEFAULT &&
+         raw.ycbcr_enc != V4L2_YCBCR_ENC_709) ||
+        (raw.quantization != V4L2_QUANTIZATION_DEFAULT &&
+         raw.quantization != V4L2_QUANTIZATION_LIM_RANGE) ||
+        (raw.xfer_func != V4L2_XFER_FUNC_DEFAULT && raw.xfer_func != V4L2_XFER_FUNC_709)) {
+        ALOGE("HEVC raw format does not preserve fixed BT.709 limited color aspects");
+        return false;
+    }
+    auto layout = V4L2Device::v4L2FormatToVideoFrameLayout(*input.first);
+    auto codedSize = V4L2Device::allocatedSizeFromV4L2Format(*input.first);
+    uint32_t outputSize = output.first->fmt.pix_mp.plane_fmt[0].sizeimage;
+    constexpr uint32_t kMaxHEVCOutputBufferSize = 32 * 1024 * 1024;
+    if (!layout || isEmpty(codedSize) || outputSize < 4096 ||
+        outputSize > kMaxHEVCOutputBufferSize ||
+        !contains(Rect(layout->mCodedSize.width, layout->mCodedSize.height),
+                  Rect(mVisibleSize.width, mVisibleSize.height))) {
+        ALOGE("Final HEVC layout or coded buffer size is invalid");
+        return false;
+    }
+    struct v4l2_selection crop = {};
+    crop.type = V4L2_BUF_TYPE_VIDEO_OUTPUT;
+    crop.target = V4L2_SEL_TGT_CROP;
+    if (mDevice->ioctl(VIDIOC_G_SELECTION, &crop) != 0 || crop.r.left != 0 ||
+        crop.r.top != 0 || crop.r.width != static_cast<uint32_t>(mVisibleSize.width) ||
+        crop.r.height != static_cast<uint32_t>(mVisibleSize.height)) {
+        ALOGE("HEVC controls changed the requested visible crop");
+        return false;
+    }
+    mInputLayout = std::move(layout);
+    mInputCodedSize = codedSize;
+    mOutputBufferSize = outputSize;
+    return true;
+}
