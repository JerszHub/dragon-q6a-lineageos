+                 std::numeric_limits<float>::max()})
+        assert(!fits(C2Config::LEVEL_HEVC_MAIN_6_2,3840,2160,f,40000000));
+    assert(!fits(C2Config::LEVEL_HEVC_MAIN_5_1,3840,2160,30,40000001));
+    assert(fits(C2Config::LEVEL_HEVC_MAIN_5_2,3840,2160,30,40000001));
+
+    EncodeInterface intf;
+    intf.mInputVisibleSize=std::make_shared<EncodeInterface::Size>(EncodeInterface::Size{3840,2160});
