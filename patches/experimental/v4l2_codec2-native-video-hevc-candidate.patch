+        int32_t defaultProfile, defaultTier, defaultLevel;
+        const bool tierMenuAvailable =
+                queryMenu(V4L2_CID_MPEG_VIDEO_HEVC_TIER, &tiers, &defaultTier);
+        const bool reviewedMissingTier =
+                !tierMenuAvailable && device->allowsQ6AIrisMissingHEVCTierControl();
+        if (!queryMenu(V4L2_CID_MPEG_VIDEO_HEVC_PROFILE, &profiles, &defaultProfile) ||
+            (!tierMenuAvailable && !reviewedMissingTier) ||
+            !queryMenu(V4L2_CID_MPEG_VIDEO_HEVC_LEVEL, &levels, &defaultLevel) ||
+            std::find(profiles.begin(), profiles.end(), V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN) == profiles.end() ||
+            (tierMenuAvailable &&
+             std::find(tiers.begin(), tiers.end(), V4L2_MPEG_VIDEO_HEVC_TIER_MAIN) == tiers.end())) {
+            ALOGE("HEVC Main profile, Main tier or level menu is unestablished; refusing fallback capabilities");
+            return caps;
+        }
