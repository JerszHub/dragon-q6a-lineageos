+    assert(fits(C2Config::LEVEL_HEVC_MAIN_1,64,64,30,64000));
+    assert(!fits(C2Config::LEVEL_HEVC_MAIN_1,256,256,30,64000));
+    assert(fits(C2Config::LEVEL_HEVC_MAIN_2,256,256,30,64000));
