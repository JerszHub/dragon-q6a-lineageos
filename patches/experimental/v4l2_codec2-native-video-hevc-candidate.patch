diff --git a/tests/hevc_headers/HEVCEncoderHeadersTest.cpp b/tests/hevc_headers/HEVCEncoderHeadersTest.cpp
new file mode 100644
index 0000000..3481a5f
--- /dev/null
+++ b/tests/hevc_headers/HEVCEncoderHeadersTest.cpp
@@ -0,0 +1,326 @@
+// Copyright 2026 Q6A native video contributors.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <v4l2_codec2/common/HEVCEncoderHeaders.h>
+
+#include <cassert>
+#include <cstdint>
+#include <fstream>
+#include <iostream>
+#include <iterator>
+#include <string>
+#include <vector>
+
+using android::HEVCEncoderHeaders;
+using Result = HEVCEncoderHeaders::Result;
+using Bytes = std::vector<uint8_t>;
+
+#if defined(__SANITIZE_ADDRESS__)
+// The restricted host runner hides /proc/<pid>/task, which LeakSanitizer needs.
+// Address/undefined-behavior checks remain enabled; no leak result is claimed.
+extern "C" int __lsan_is_turned_off() { return 1; }
+#endif
+
+namespace {
+struct Writer {
+    Bytes bits;
+    void put(uint64_t value, unsigned count) {
+        for (unsigned i = count; i; --i) bits.push_back((value >> (i - 1)) & 1);
+    }
+    void ue(uint32_t value) {
+        uint64_t encoded = uint64_t{value} + 1;
+        unsigned count = 0;
+        for (uint64_t n = encoded; n; n >>= 1) ++count;
+        put(0, count - 1);
+        put(encoded, count);
+    }
+    Bytes nal(uint8_t type) {
+        put(1, 1);
+        while (bits.size() % 8) put(0, 1);
+        Bytes result = {0, 0, 0, 1, static_cast<uint8_t>(type << 1), 1};
+        unsigned zeros = 0;
+        for (size_t i = 0; i < bits.size(); i += 8) {
+            uint8_t byte = 0;
+            for (size_t j = 0; j < 8; ++j) byte = (byte << 1) | bits[i + j];
+            if (zeros >= 2 && byte <= 3) {
+                result.push_back(3);
+                zeros = 0;
+            }
+            result.push_back(byte);
+            zeros = byte == 0 ? zeros + 1 : 0;
+        }
+        return result;
+    }
+};
+
+Bytes vps(uint32_t id = 0, uint32_t profile = 1, uint32_t tier = 0,
+          uint32_t levelIdc = 120, uint32_t space = 0, uint32_t maxLayers = 0,
+          uint32_t reserved = 0xffff) {
+    Writer writer;
+    writer.put(id, 4);
+    writer.put(3, 2);  // base_layer_internal_flag, base_layer_available_flag
+    writer.put(maxLayers, 6);
+    writer.put(0, 3);  // max_sub_layers_minus1
+    writer.put(1, 1);
+    writer.put(reserved, 16);
+    writer.put((space << 6) | (tier << 5) | profile, 8);
+    writer.put(0, 32);
+    writer.put(0, 48);
+    writer.put(levelIdc, 8);
+    return writer.nal(32);
+}
+
+// Synthetic SPS prefix for boundary/unit tests; software-encoded fixtures below
+// separately exercise complete, independently decodable HEVC parameter sets.
+Bytes sps(uint32_t width = 64, uint32_t height = 64, uint32_t profile = 1,
+          uint32_t depth = 0, uint32_t chroma = 1, uint32_t vpsId = 0,
+          uint32_t spsId = 0, uint32_t bottomCrop = 0, uint32_t levelIdc = 120) {
+    Writer writer;
+    writer.put(vpsId, 4);
+    writer.put(0, 3);
+    writer.put(1, 1);
+    writer.put(profile, 8);  // profile_space=0, main tier
+    writer.put(0, 32);
+    writer.put(0, 48);
+    writer.put(levelIdc, 8);
+    writer.ue(spsId);
+    writer.ue(chroma);
+    writer.ue(width);
+    writer.ue(height);
+    writer.put(bottomCrop ? 1 : 0, 1);
+    if (bottomCrop) {
+        writer.ue(0); writer.ue(0); writer.ue(0); writer.ue(bottomCrop);
+    }
+    writer.ue(depth);
+    writer.ue(depth);
+    return writer.nal(33);
+}
+
+Bytes pps(uint32_t id = 0, uint32_t spsId = 0) {
+    Writer writer;
+    writer.ue(id);
+    writer.ue(spsId);
+    return writer.nal(34);
+}
+
+Bytes slice(bool first = true, uint32_t ppsId = 0, uint8_t type = 19) {
+    Writer writer;
+    writer.put(first, 1);
+    if (type >= 16 && type <= 23) writer.put(0, 1);
+    writer.ue(ppsId);
+    return writer.nal(type);
+}
+
+Bytes join(std::initializer_list<Bytes> items) {
+    Bytes result;
+    for (const auto& item : items) result.insert(result.end(), item.begin(), item.end());
+    return result;
+}
+
+Result feed(HEVCEncoderHeaders& state, const Bytes& bytes, Bytes* csd) {
+    return state.process(bytes.data(), bytes.size(), csd);
+}
+
+Bytes hex(const std::string& text) {
+    assert(text.size() % 2 == 0);
+    Bytes result;
+    for (size_t i = 0; i < text.size(); i += 2) {
+        result.push_back(static_cast<uint8_t>(std::stoul(text.substr(i, 2), nullptr, 16)));
+    }
+    return result;
+}
+
+void tests() {
+    Bytes csd;
+    HEVCEncoderHeaders state;
+    state.reset(64, 64);
+    assert(state.matchesSize(64, 64) && !state.matchesSize(128, 64));
+    // Separate header callbacks (including reversed set arrival) do not emit a
+    // picture or CSD. Timestamp zero is deliberately outside this helper API.
+    assert(feed(state, pps(), &csd) == Result::kHeaderOnly && csd.empty());
+    assert(feed(state, vps(), &csd) == Result::kHeaderOnly && csd.empty());
+    assert(feed(state, sps(), &csd) == Result::kHeaderOnly && csd.empty());
+    assert(feed(state, slice(), &csd) == Result::kFrame);
+    assert(csd == join({vps(), sps(), pps()}));
+    assert(feed(state, slice(), &csd) == Result::kFrame && csd.empty());
+    assert(feed(state, join({vps(), sps(), pps()}), &csd) == Result::kHeaderOnly && csd.empty());
+    state.flush();
+    assert(feed(state, slice(), &csd) == Result::kFrame && csd.empty());
+    assert(feed(state, pps(1), &csd) == Result::kError);  // no silent config change
+    assert(feed(state, join({slice(), slice(false)}), &csd) == Result::kFrame);
+    assert(feed(state, join({slice(), slice()}), &csd) == Result::kError);
+    assert(feed(state, slice(false), &csd) == Result::kError);
+
+    state.reset(64, 64);
+    assert(feed(state, join({vps(), sps(), pps(), slice()}), &csd) == Result::kFrame);
+    assert(csd == join({vps(), sps(), pps()}));
+    assert(state.levelIdc() == 120);
+    state.reset(64, 64, 120);
+    assert(feed(state, join({vps(), sps(), pps(), slice()}), &csd) == Result::kFrame);
+    state.reset(64, 64, 123);
+    assert(feed(state, sps(), &csd) == Result::kError);  // strict configured level
+    assert(feed(state, vps(), &csd) == Result::kError);
+    // Both parameter sets must establish Main tier/profile and matching level,
+    // even when a standalone caller disables the configured-level comparison.
+    for (const Bytes& invalid : {vps(0, 2), vps(0, 1, 1), vps(0, 1, 0, 121),
+                                 vps(0, 1, 0, 120, 1), vps(0, 1, 0, 120, 0, 1),
+                                 vps(0, 1, 0, 120, 0, 0, 0xfffe)}) {
+        state.reset(64, 64);
+        assert(feed(state, invalid, &csd) == Result::kError && csd.empty());
+    }
+    const Bytes completeVPS = vps();
+    for (size_t size = 6; size < 15; ++size) {
+        state.reset(64, 64);
+        Bytes truncated(completeVPS.begin(), completeVPS.begin() + size);
+        assert(feed(state, truncated, &csd) == Result::kError);
+    }
+    state.reset(64, 64);
+    assert(feed(state, vps(0, 1, 0, 123), &csd) == Result::kHeaderOnly);
+    assert(feed(state, sps(), &csd) == Result::kError && csd.empty());
+    assert(feed(state, join({sps(64, 64, 1, 0, 1, 0, 0, 0, 123), pps(), slice()}), &csd) == Result::kFrame);
+    state.reset(64, 64);
+    assert(feed(state, sps(), &csd) == Result::kHeaderOnly);
+    assert(feed(state, vps(0, 1, 0, 123), &csd) == Result::kError);
+    assert(feed(state, join({vps(), pps(), slice()}), &csd) == Result::kFrame);
+
+    // Exact parameter sets from the successful 32-frame Iris driver capture:
+    // output.hevc SHA256 8f6da165355b2f7901e34f31f33e1a81724158cdbcb1f10c855371dee474b3fc.
+    // The synthetic slice below tests prefix/linkage only; full captured packet
+    // boundaries and the independently decoded stream are checked separately.
+    const Bytes driverVPS = hex("0000000140010c01ffff016000000300b00000030000030099ac0c01000003001e0000030140");
+    const Bytes driverSPS = hex("00000001420101016000000300b00000030000030099a001e02002207c4e5aee4c92ea6a0202020802000003003c0000030176850940");
+    const Bytes driverPPS = hex("000000014401c0e30f08d0542a150a857d8420");
+    state.reset(3840, 2160, 153);
+    assert(feed(state, driverVPS, &csd) == Result::kHeaderOnly && csd.empty());
+    assert(feed(state, driverSPS, &csd) == Result::kHeaderOnly && csd.empty());
+    assert(feed(state, driverPPS, &csd) == Result::kHeaderOnly && csd.empty());
+    assert(feed(state, slice(), &csd) == Result::kFrame && state.levelIdc() == 153);
+    assert(csd == join({driverVPS, driverSPS, driverPPS}));
+    Bytes highTierVPS = driverVPS;
+    highTierVPS[10] |= 0x20;  // general_tier_flag after the four-byte VPS prefix
+    state.reset(3840, 2160, 153);
+    assert(feed(state, join({highTierVPS, driverSPS, driverPPS, slice()}), &csd) == Result::kError);
+    state.reset(64, 64);
+    assert(feed(state, sps(64, 64, 1, 0, 1, 0, 0, 0, 121), &csd) == Result::kError);
+    state.reset(64, 64);
+    assert(feed(state, vps(), &csd) == Result::kHeaderOnly);
+    state.flush();
+    assert(feed(state, join({sps(), pps(), slice()}), &csd) == Result::kError);
+    state.reset(64, 64);
+    assert(feed(state, slice(), &csd) == Result::kError);
+
+    // Failed callbacks must not leave half their headers in the cache.
+    assert(feed(state, vps(), &csd) == Result::kHeaderOnly);
+    assert(feed(state, join({sps(), vps(1)}), &csd) == Result::kError);
+    assert(feed(state, join({pps(), slice()}), &csd) == Result::kError);
+
+    for (const Bytes& invalid : {sps(64, 64, 2), sps(64, 64, 1, 2), sps(64, 64, 1, 0, 3),
+                                 sps(128, 64), sps(64, 128)}) {
+        state.reset(64, 64);
+        assert(feed(state, invalid, &csd) == Result::kError);
+    }
+    state.reset(64, 64);
+    assert(feed(state, join({vps(), sps(64, 80, 1, 0, 1, 0, 0, 8), pps(), slice()}), &csd) == Result::kFrame);
+    for (const Bytes& inconsistent : {join({vps(1), sps(), pps(), slice()}),
+                                      join({vps(), sps(), pps(0, 1), slice()}),
+                                      join({vps(), sps(), pps(), slice(true, 1)})}) {
+        state.reset(64, 64);
+        assert(feed(state, inconsistent, &csd) == Result::kError);
+    }
+    for (Bytes invalid : {Bytes{}, Bytes{0, 0, 0, 1}, Bytes{0, 0, 1, 0x40, 1},
+                          Bytes{0x40, 1, 0x80}, Bytes{1, 0, 0, 1, 0x40, 1, 0x80}}) {
+        state.reset();
+        assert(feed(state, invalid, &csd) == Result::kError);
+    }
+    for (unsigned badHeader = 0; badHeader < 3; ++badHeader) {
+        Bytes invalid = vps();
+        if (badHeader == 0) invalid[4] |= 0x80;
+        if (badHeader == 1) invalid[5] |= 8;
+        if (badHeader == 2) invalid[5] = 0;
+        assert(feed(state, invalid, &csd) == Result::kError);
+    }
+    Bytes oversized(HEVCEncoderHeaders::kMaxParameterSetBytes + 5, 0xff);
+    oversized[0] = oversized[1] = oversized[2] = 0;
+    oversized[3] = 1; oversized[4] = 0x40; oversized[5] = 1;
+    assert(feed(state, oversized, &csd) == Result::kError);
+    Bytes tooLarge(HEVCEncoderHeaders::kMaxPacketBytes + 1, 0);
+    assert(feed(state, tooLarge, &csd) == Result::kError);
+    Bytes many;
+    const Bytes aud = {0, 0, 1, 0x46, 1, 0x50};
+    for (size_t i = 0; i < HEVCEncoderHeaders::kMaxNalUnits; ++i) many.insert(many.end(), aud.begin(), aud.end());
+    assert(feed(state, many, &csd) == Result::kHeaderOnly);
+    many.insert(many.end(), aud.begin(), aud.end());
+    assert(feed(state, many, &csd) == Result::kError);
+    assert(state.process(nullptr, 0, &csd) == Result::kError);
+    assert(state.process(nullptr, 1, &csd) == Result::kError);
+    assert(state.process(aud.data(), aud.size(), nullptr) == Result::kError);
+
+    // Exhaust every short callback prefix and deterministic random malformed
+    // packets under sanitizers. All failures remain bounded and transactional.
+    const Bytes complete = join({vps(), sps(), pps(), slice()});
+    for (size_t size = 0; size < complete.size(); ++size) {
+        HEVCEncoderHeaders shortState;
+        shortState.process(complete.data(), size, &csd);
+    }
+    uint32_t rng = 0x97531;
+    for (unsigned i = 0; i < 20000; ++i) {
+        Bytes bytes(i % 127);
+        for (uint8_t& value : bytes) {
+            rng ^= rng << 13; rng ^= rng >> 17; rng ^= rng << 5;
+            value = static_cast<uint8_t>(rng);
+        }
+        HEVCEncoderHeaders randomState;
+        randomState.process(bytes.data(), bytes.size(), &csd);
+    }
+}
+}  // namespace
+
+int main(int argc, char** argv) {
+    tests();
+    if (argc >= 2) {
+        std::ifstream input(argv[1], std::ios::binary);
+        assert(input.good());
+        Bytes packet((std::istreambuf_iterator<char>(input)), std::istreambuf_iterator<char>());
+        HEVCEncoderHeaders state;
+        state.reset(64, 64);
+        Bytes csd;
+        assert(feed(state, packet, &csd) == Result::kFrame && !csd.empty());
+        const Bytes wholePacketCSD = csd;
+        // Re-deliver the real software parameter sets one complete NAL per
+        // callback, proving this is not only a joined-header extractor.
+        std::vector<size_t> starts;
+        for (size_t i = 0; i + 2 < packet.size(); ++i) {
+            if (packet[i] == 0 && packet[i + 1] == 0 && packet[i + 2] == 1) {
+                starts.push_back(i && packet[i - 1] == 0 ? i - 1 : i);
+                i += 2;
+            }
+        }
+        assert(!starts.empty());
+        starts.push_back(packet.size());
+        state.reset(64, 64);
+        unsigned frames = 0, configurations = 0;
+        for (size_t i = 0; i + 1 < starts.size(); ++i) {
+            Result result = state.process(packet.data() + starts[i], starts[i + 1] - starts[i], &csd);
+            assert(result != Result::kError);
+            if (result == Result::kFrame) ++frames;
+            if (!csd.empty()) {
+                ++configurations;
+                assert(result == Result::kFrame && csd == wholePacketCSD);
+            }
+        }
+        assert(frames == 1 && configurations == 1);
+        std::cout << "Software HEVC Main fixture accepted; csd bytes=" << csd.size() << '\n';
+    }
+    if (argc >= 3) {
+        std::ifstream input(argv[2], std::ios::binary);
+        assert(input.good());
+        Bytes packet((std::istreambuf_iterator<char>(input)), std::istreambuf_iterator<char>());
+        HEVCEncoderHeaders state;
+        state.reset(64, 64);
+        Bytes csd;
+        assert(feed(state, packet, &csd) == Result::kError && csd.empty());
+        std::cout << "Software HEVC Main10 fixture correctly rejected\n";
+    }
+    std::cout << "HEVC encoder header boundary/lifecycle tests passed\n";
+}
