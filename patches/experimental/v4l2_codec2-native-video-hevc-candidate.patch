+#!/usr/bin/env python3
+# SPDX-License-Identifier: BSD-3-Clause
+"""Compile actual component-name logic with minimal external-type/log stubs.
+
+This checks registration/classification, not Android headers or Codec2 ABI.
+No Android device or libraries are accessed.
+"""
+import argparse
