+    reset(); state.optIn=false; state.queryTierRc=state.getTierRc=0; V4L2Encoder defaultStrict;
+    assert(defaultStrict.configureHEVC(C2Config::PROFILE_HEVC_MAIN,config) && state.tierSets==1);
+    for(int failure=0; failure<5; ++failure) {
+        reset(); state.queryTierRc=state.getTierRc=0;
+        if(failure==0)state.tierFlags=V4L2_CTRL_FLAG_DISABLED;
+        if(failure==1)state.tierType=V4L2_CTRL_TYPE_BUTTON;
+        if(failure==2)state.tierMenuRc=-1;
+        if(failure==3)state.tryRc=-1;
+        if(failure==4)state.changeReadback=true;
+        V4L2Encoder rejected;
+        assert(!rejected.configureHEVC(C2Config::PROFILE_HEVC_MAIN,config));
+    }
+    reset(); state.forceSupported=false; V4L2Encoder noForce;
+    assert(!noForce.configureHEVC(C2Config::PROFILE_HEVC_MAIN,config));
+    std::cout << "Q6A_IRIS_MISSING_HEVC_TIER_GATE_PASS\n";
+}
+'''
+
+
