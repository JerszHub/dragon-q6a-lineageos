@@ -0,0 +1,63 @@
+// Copyright 2026 Q6A native video contributors.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef ANDROID_V4L2_CODEC2_COMMON_HEVC_ENCODER_HEADERS_H
+#define ANDROID_V4L2_CODEC2_COMMON_HEVC_ENCODER_HEADERS_H
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace android {
+
+// Bounded, Android-independent state for the encoder's Annex-B output. A capture
+// callback must contain complete NAL units and at most one complete picture;
+// byte-fragmented NAL units are not supported. Parameter sets may arrive in
+// separate callbacks. Header-only callbacks never represent an input picture.
+// This validates parameter-set linkage, VPS/SPS Main-profile/Main-tier/level
+// prefixes and SPS 8-bit/4:2:0 geometry, not full HEVC bitstream conformance
+// (that requires a decoder).
+class HEVCEncoderHeaders {
+public:
+    enum class Result { kError, kHeaderOnly, kFrame };
+    static constexpr size_t kMaxParameterSetBytes = 64 * 1024;
+    static constexpr size_t kMaxPacketBytes = 16 * 1024 * 1024;
+    static constexpr size_t kMaxNalUnits = 256;
+
+    // Zero expected fields disable their comparisons, for standalone tests.
+    // The initial integration requires the exact configured VPS/SPS level; a
+    // control acknowledgement alone is not evidence of bitstream signaling.
+    void reset(uint32_t expectedWidth = 0, uint32_t expectedHeight = 0,
+               uint8_t expectedLevelIdc = 0);
+    uint8_t levelIdc() const { return static_cast<uint8_t>(mSPSLevelIdc); }
+    bool matchesSize(uint32_t width, uint32_t height) const {
+        return width == mExpectedWidth && height == mExpectedHeight;
+    }
+    // Stream-off does not promise to resend headers. Preserve a configuration
+    // already delivered to the client; discard a not-yet-delivered partial set.
+    void flush();
+    // On the first valid picture, return VPS/SPS/PPS with four-byte start codes
+    // in |csd|. Later pictures return empty |csd|. Failure changes no state.
+    // Changed parameter sets require stop/reconfigure, including after flush.
+    Result process(const uint8_t* data, size_t size, std::vector<uint8_t>* csd);
+
+private:
+    std::vector<uint8_t> mVPS;
+    std::vector<uint8_t> mSPS;
+    std::vector<uint8_t> mPPS;
+    uint32_t mExpectedWidth = 0;
+    uint32_t mExpectedHeight = 0;
+    uint8_t mExpectedLevelIdc = 0;
+    uint32_t mVPSLevelIdc = 0;
+    uint32_t mSPSLevelIdc = 0;
+    uint32_t mVPSId = 0;
+    uint32_t mSPSVPSId = 0;
+    uint32_t mSPSId = 0;
+    uint32_t mPPSSPSId = 0;
+    uint32_t mPPSId = 0;
+    bool mDelivered = false;
+};
+
+}  // namespace android
+#endif  // ANDROID_V4L2_CODEC2_COMMON_HEVC_ENCODER_HEADERS_H
