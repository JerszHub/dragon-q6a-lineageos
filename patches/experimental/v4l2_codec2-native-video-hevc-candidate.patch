diff --git a/components/HevcHdrMetadata.cpp b/components/HevcHdrMetadata.cpp
new file mode 100644
index 0000000..9af5629
--- /dev/null
+++ b/components/HevcHdrMetadata.cpp
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: MIT
+#include <v4l2_codec2/components/HevcHdrMetadata.h>
+
+namespace android {
+
+bool HevcHdrMetadata::recordInput(int32_t bitstreamId, const uint8_t* data, size_t size,
+                                bool codecConfig, int* parseResult) {
+    if (parseResult) *parseResult = 0;
+    if (mSnapshots.count(bitstreamId) || mSnapshots.size() >= kMaxSnapshots) return false;
+
+    // New codec configuration after picture data starts a new coded sequence.
+    // Consecutive CSD buffers belong to that same configuration, so clearing
+    // once preserves SEI carried in a separate CSD buffer.
+    if (codecConfig && mSawPictureInput) {
+        q6a_hdr_reset(&mCoded);
+        mLengthBytes = 0;
+        mSawPictureInput = false;
+    } else if (!codecConfig) {
+        mSawPictureInput = true;
+    }
+
+    int result = 0;
+    if (data && size && size <= Q6A_HDR_MAX_INPUT) {
+        q6a_hdr_format format;
+        unsigned lengthBytes = 0;
+        bool recognized = true;
+        size_t zeros = 0;
+        while (zeros < size && data[zeros] == 0) ++zeros;
+        if (size >= 23 && data[0] == 1 && (codecConfig || mLengthBytes == 0)) {
+            format = Q6A_HDR_HVCC;
+        } else if (mLengthBytes) {
+            format = Q6A_HDR_LENGTH_PREFIXED;
+            lengthBytes = mLengthBytes;
+        } else if (zeros >= 2 && zeros < size && data[zeros] == 1) {
+            format = Q6A_HDR_ANNEX_B;
+        } else {
+            recognized = false;
+        }
+        if (recognized) {
+            result = q6a_hdr_parse(data, size, format, lengthBytes, &mCoded);
+            if (result >= 0 && format == Q6A_HDR_HVCC) mLengthBytes = (data[21] & 3U) + 1U;
+        }
+    } else if (size > Q6A_HDR_MAX_INPUT) {
+        result = Q6A_HDR_LIMIT;
+    }
+
+    // The descriptor conversion applies the same public Android representable
+    // range check used by the tested helper. No metadata values are invented.
+    uint8_t descriptor[25];
+    q6a_hdr_c2_payload payload{};
+    std::optional<q6a_hdr_c2_payload> value;
+    if (q6a_hdr_to_descriptor(&mCoded, descriptor) > 0 &&
+        q6a_hdr_to_c2(&mCoded, &payload) > 0) {
+        value = payload;
+    }
+    mSnapshots.emplace(bitstreamId, value);
+    if (parseResult) *parseResult = result;
+    return true;
+}
+
+std::optional<q6a_hdr_c2_payload> HevcHdrMetadata::snapshot(int32_t bitstreamId) const {
+    const auto found = mSnapshots.find(bitstreamId);
+    return found == mSnapshots.end() ? std::nullopt : found->second;
+}
+
+void HevcHdrMetadata::forget(int32_t bitstreamId) {
+    mSnapshots.erase(bitstreamId);
+}
+
+void HevcHdrMetadata::reset() {
+    q6a_hdr_reset(&mCoded);
+    mLengthBytes = 0;
+    mSawPictureInput = false;
+    mSnapshots.clear();
+}
+
+}  // namespace android
diff --git a/components/HevcHdrSei.c b/components/HevcHdrSei.c
new file mode 100644
index 0000000..8f13a5c
--- /dev/null
+++ b/components/HevcHdrSei.c
@@ -0,0 +1,302 @@
+/* SPDX-License-Identifier: MIT */
+#include <v4l2_codec2/components/HevcHdrSei.h>
+
+_Static_assert(sizeof(q6a_hdr_state) == 32, "stable raw HDR parser state");
+_Static_assert(sizeof(q6a_hdr_c2_payload) == 48, "C2 HDR twelve-float payload");
+
+typedef struct rbsp_reader {
+    const q6a_hdr_u8 *data;
+    q6a_hdr_size size, offset;
+    unsigned zeros;
+    int error;
+} rbsp_reader;
+
+typedef struct parse_context {
+    q6a_hdr_state staged;
+    unsigned found, nals, messages;
+} parse_context;
+
+static q6a_hdr_u16 be16(const q6a_hdr_u8 *p) {
+    return (q6a_hdr_u16)(((q6a_hdr_u16)p[0] << 8) | p[1]);
+}
+
+static q6a_hdr_u32 be32(const q6a_hdr_u8 *p) {
+    return ((q6a_hdr_u32)p[0] << 24) | ((q6a_hdr_u32)p[1] << 16)
+           | ((q6a_hdr_u32)p[2] << 8) | p[3];
+}
+
+static void le16(q6a_hdr_u8 *p, q6a_hdr_u16 value) {
+    p[0] = (q6a_hdr_u8)value;
+    p[1] = (q6a_hdr_u8)(value >> 8);
+}
+
+void q6a_hdr_reset(q6a_hdr_state *state) {
+    if (state) {
+        q6a_hdr_u8 *p = (q6a_hdr_u8 *)state;
+        for (q6a_hdr_size i = 0; i < sizeof(*state); ++i) p[i] = 0;
+    }
+}
+
+/* Return one unescaped RBSP byte, zero at EOF, or -1 on an illegal EBSP. */
+static int next_byte(rbsp_reader *reader, q6a_hdr_u8 *out) {
+    if (reader->error) return -1;
+    if (reader->offset == reader->size) return 0;
+    q6a_hdr_u8 value = reader->data[reader->offset++];
+    if (reader->zeros >= 2) {
+        if (value == 3) {
+            if (reader->offset == reader->size || reader->data[reader->offset] > 3) {
+                reader->error = 1;
+                return -1;
+            }
+            /* The byte history is physical EBSP, so the prevention byte
+             * resets it before its following payload byte is consumed. */
+            reader->zeros = 0;
+            value = reader->data[reader->offset++];
+        } else if (value <= 2) {
+            reader->error = 1;
+            return -1;
+        }
+    }
+    reader->zeros = value == 0 ? reader->zeros + 1 : 0;
+    *out = value;
+    return 1;
+}
+
+static int chromaticity_valid(const q6a_hdr_state *state) {
+    for (unsigned i = 0; i < 3; ++i) {
+        if (state->primary_x[i] > 50000 || state->primary_y[i] > 50000) return 0;
+    }
+    return state->white_x <= 50000 && state->white_y <= 50000;
+}
+
+static int mastering(parse_context *context, const q6a_hdr_u8 p[24]) {
+    q6a_hdr_state *state = &context->staged;
+    for (unsigned i = 0; i < 3; ++i) {
+        state->primary_x[i] = be16(p + i * 4);
+        state->primary_y[i] = be16(p + i * 4 + 2);
+    }
+    state->white_x = be16(p + 12);
+    state->white_y = be16(p + 14);
+    state->max_luminance = be32(p + 16);
+    state->min_luminance = be32(p + 20);
+    if (!chromaticity_valid(state) || state->max_luminance <= state->min_luminance)
+        return Q6A_HDR_RANGE;
+    state->present |= Q6A_HDR_MDCV;
+    context->found |= Q6A_HDR_MDCV;
+    return 0;
+}
+
+static int sei(const q6a_hdr_u8 *data, q6a_hdr_size size, parse_context *context) {
+    rbsp_reader reader = {data, size, 0, 0, 0};
+    for (;;) {
+        q6a_hdr_u8 value;
+        int result = next_byte(&reader, &value);
+        if (result != 1) return Q6A_HDR_MALFORMED; /* trailing stop byte required */
+        if (value == 0x80) {
+            rbsp_reader look = reader;
+            q6a_hdr_u8 ignored;
+            int remaining = next_byte(&look, &ignored);
+            if (remaining == 0) return 0; /* rbsp_trailing_bits */
+            if (remaining < 0) return Q6A_HDR_MALFORMED;
+        }
+        if (++context->messages > Q6A_HDR_MAX_MESSAGES) return Q6A_HDR_LIMIT;
+        q6a_hdr_u32 type = 0;
+        for (;;) {
+            if (type > (__UINT32_MAX__ - value)) return Q6A_HDR_LIMIT;
+            type += value;
+            if (value != 255) break;
+            if (next_byte(&reader, &value) != 1) return Q6A_HDR_MALFORMED;
+        }
+        q6a_hdr_u32 payload = 0;
+        do {
+            if (next_byte(&reader, &value) != 1) return Q6A_HDR_MALFORMED;
+            if (payload > (__UINT32_MAX__ - value)) return Q6A_HDR_LIMIT;
+            payload += value;
+            if (payload > Q6A_HDR_MAX_INPUT) return Q6A_HDR_LIMIT;
+        } while (value == 255);
+        if ((type == 137 && payload != 24) || (type == 144 && payload != 4))
+            return Q6A_HDR_MALFORMED;
+        q6a_hdr_u8 captured[24];
+        for (q6a_hdr_u32 i = 0; i < payload; ++i) {
+            if (next_byte(&reader, &value) != 1) return Q6A_HDR_MALFORMED;
+            if (type == 137 || type == 144) captured[i] = value;
+        }
+        if (type == 137) {
+            result = mastering(context, captured);
+            if (result < 0) return result;
+        } else if (type == 144) {
+            context->staged.max_cll = be16(captured);
+            context->staged.max_fall = be16(captured + 2);
+            context->staged.present |= Q6A_HDR_CLLI;
+            context->found |= Q6A_HDR_CLLI;
+        }
+    }
+}
+
+static int nal(const q6a_hdr_u8 *data, q6a_hdr_size size,
+               int expected_type, parse_context *context) {
+    if (++context->nals > Q6A_HDR_MAX_NALS) return Q6A_HDR_LIMIT;
+    if (size < 2 || data[0] & 0x80 || !(data[1] & 7)) return Q6A_HDR_MALFORMED;
+    unsigned type = (data[0] >> 1) & 63;
+    unsigned layer = ((data[0] & 1U) << 5) | (data[1] >> 3);
+    if (expected_type >= 0 && type != (unsigned)expected_type) return Q6A_HDR_MALFORMED;
+    /* Enhancement-layer metadata must not overwrite base-layer metadata. */
+    if (layer != 0 || (type != 39 && type != 40)) return 0;
+    return sei(data + 2, size - 2, context);
+}
+
+static int find_start(const q6a_hdr_u8 *data, q6a_hdr_size size,
+                      q6a_hdr_size from, q6a_hdr_size *offset, unsigned *bytes) {
+    for (q6a_hdr_size i = from; i + 2 < size; ++i) {
+        if (data[i] || data[i + 1]) continue;
+        if (data[i + 2] == 1) {
+            *offset = i; *bytes = 3;
+            return 1;
+        }
+        if (i + 3 < size && !data[i + 2] && data[i + 3] == 1) {
+            *offset = i; *bytes = 4;
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static int annex_b(const q6a_hdr_u8 *data, q6a_hdr_size size, parse_context *context) {
+    q6a_hdr_size start = 0;
+    unsigned prefix = 0;
+    if (!find_start(data, size, 0, &start, &prefix)) return Q6A_HDR_MALFORMED;
+    for (q6a_hdr_size i = 0; i < start; ++i) if (data[i]) return Q6A_HDR_MALFORMED;
+    for (;;) {
+        q6a_hdr_size first = start + prefix, next = 0;
+        unsigned next_prefix = 0;
+        int more = find_start(data, size, first, &next, &next_prefix);
+        q6a_hdr_size end = more ? next : size;
+        while (end > first && data[end - 1] == 0) --end; /* trailing_zero_8bits */
+        int result = nal(data + first, end - first, -1, context);
+        if (result < 0) return result;
+        if (!more) return 0;
+        start = next;
+        prefix = next_prefix;
+    }
+}
+
+static int length_prefixed(const q6a_hdr_u8 *data, q6a_hdr_size size,
+                          unsigned length_bytes, parse_context *context) {
+    q6a_hdr_size offset = 0;
+    while (offset < size) {
+        if (size - offset < length_bytes) return Q6A_HDR_MALFORMED;
+        q6a_hdr_u32 bytes = 0;
+        for (unsigned i = 0; i < length_bytes; ++i) bytes = (bytes << 8) | data[offset++];
+        if (bytes < 2 || bytes > size - offset) return Q6A_HDR_MALFORMED;
+        int result = nal(data + offset, bytes, -1, context);
+        if (result < 0) return result;
+        offset += bytes;
+    }
+    return 0;
+}
+
+static int hvcc(const q6a_hdr_u8 *data, q6a_hdr_size size, parse_context *context) {
+    if (size < 23 || data[0] != 1) return Q6A_HDR_MALFORMED;
+    q6a_hdr_size offset = 23;
+    unsigned arrays = data[22];
+    for (unsigned i = 0; i < arrays; ++i) {
+        if (size - offset < 3 || data[offset] & 0x40) return Q6A_HDR_MALFORMED;
+        unsigned type = data[offset++] & 63;
+        unsigned count = be16(data + offset);
+        offset += 2;
+        if (count > Q6A_HDR_MAX_NALS - context->nals) return Q6A_HDR_LIMIT;
+        for (unsigned j = 0; j < count; ++j) {
+            if (size - offset < 2) return Q6A_HDR_MALFORMED;
+            q6a_hdr_size bytes = be16(data + offset);
+            offset += 2;
+            if (bytes < 2 || bytes > size - offset) return Q6A_HDR_MALFORMED;
+            int result = nal(data + offset, bytes, (int)type, context);
+            if (result < 0) return result;
+            offset += bytes;
+        }
+    }
+    return offset == size ? 0 : Q6A_HDR_MALFORMED;
+}
+
+int q6a_hdr_parse(const q6a_hdr_u8 *data, q6a_hdr_size size,
+                  enum q6a_hdr_format format, unsigned length_bytes,
+                  q6a_hdr_state *state) {
+    if (!state || (size && !data) || state->present & ~(Q6A_HDR_MDCV | Q6A_HDR_CLLI))
+        return Q6A_HDR_BAD_ARGUMENT;
+    if (format < Q6A_HDR_ANNEX_B || format > Q6A_HDR_HVCC
+        || (format == Q6A_HDR_LENGTH_PREFIXED ? length_bytes < 1 || length_bytes > 4
+                                           : length_bytes != 0))
+        return Q6A_HDR_BAD_ARGUMENT;
+    if (size > Q6A_HDR_MAX_INPUT) return Q6A_HDR_LIMIT;
+    if (!size) return 0;
+    parse_context context;
+    context.staged = *state;
+    context.found = context.nals = context.messages = 0;
+    int result;
+    if (format == Q6A_HDR_ANNEX_B) result = annex_b(data, size, &context);
+    else if (format == Q6A_HDR_LENGTH_PREFIXED)
+        result = length_prefixed(data, size, length_bytes, &context);
+    else result = hvcc(data, size, &context);
+    if (result < 0) return result;
+    *state = context.staged;
+    return (int)context.found;
+}
+
+static int state_valid(const q6a_hdr_state *state) {
+    if (!state || state->present & ~(Q6A_HDR_MDCV | Q6A_HDR_CLLI)) return 0;
+    if (state->present & Q6A_HDR_MDCV)
+        return chromaticity_valid(state) && state->max_luminance > state->min_luminance;
+    return 1;
+}
+
+int q6a_hdr_to_descriptor(const q6a_hdr_state *state, q6a_hdr_u8 out[25]) {
+    if (!out || !state_valid(state)) return Q6A_HDR_BAD_ARGUMENT;
+    if (!state->present) return 0;
+    q6a_hdr_u16 fields[12] = {0};
+    if (state->present & Q6A_HDR_MDCV) {
+        if (state->max_luminance > 655350000U || state->min_luminance > 65535U)
+            return Q6A_HDR_RANGE;
+        static const unsigned order[3] = {2, 0, 1};
+        for (unsigned i = 0; i < 3; ++i) {
+            fields[i * 2] = state->primary_x[order[i]];
+            fields[i * 2 + 1] = state->primary_y[order[i]];
+        }
+        fields[6] = state->white_x;
+        fields[7] = state->white_y;
+        fields[8] = (q6a_hdr_u16)(((q6a_hdr_u64)state->max_luminance + 5000U) / 10000U);
+        fields[9] = (q6a_hdr_u16)state->min_luminance;
+    }
+    if (state->present & Q6A_HDR_CLLI) {
+        fields[10] = state->max_cll;
+        fields[11] = state->max_fall;
+    }
+    q6a_hdr_u8 buffer[25];
+    buffer[0] = 0;
+    for (unsigned i = 0; i < 12; ++i) le16(buffer + 1 + i * 2, fields[i]);
+    for (unsigned i = 0; i < 25; ++i) out[i] = buffer[i];
+    return 1;
+}
+
+int q6a_hdr_to_c2(const q6a_hdr_state *state, q6a_hdr_c2_payload *out) {
+    if (!out || !state_valid(state)) return Q6A_HDR_BAD_ARGUMENT;
+    if (!state->present) return 0;
+    q6a_hdr_c2_payload value = {0};
+    if (state->present & Q6A_HDR_MDCV) {
+        value.red_x = (float)state->primary_x[2] / 50000.0f;
+        value.red_y = (float)state->primary_y[2] / 50000.0f;
+        value.green_x = (float)state->primary_x[0] / 50000.0f;
+        value.green_y = (float)state->primary_y[0] / 50000.0f;
+        value.blue_x = (float)state->primary_x[1] / 50000.0f;
+        value.blue_y = (float)state->primary_y[1] / 50000.0f;
+        value.white_x = (float)state->white_x / 50000.0f;
+        value.white_y = (float)state->white_y / 50000.0f;
+        value.max_luminance = (float)state->max_luminance / 10000.0f;
+        value.min_luminance = (float)state->min_luminance / 10000.0f;
+    }
+    if (state->present & Q6A_HDR_CLLI) {
+        value.max_cll = (float)state->max_cll;
+        value.max_fall = (float)state->max_fall;
+    }
+    *out = value;
+    return 1;
+}
