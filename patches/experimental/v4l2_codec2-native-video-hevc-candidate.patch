+bool V4L2Device::allowsQ6AIrisMissingHEVCTierControl() {
+    // This opt-in applies only to the exact loaded Iris encoder reviewed with
+    // a direct Main-tier encode. It does not infer bitstream tier from an
+    // absent control: the HEVC VPS/SPS output checks remain mandatory.
+    if (!property_get_bool("ro.vendor.v4l2_codec2.hevc.iris_main_tier", false)) return false;
+
+    struct v4l2_capability capability = {};
+    if (ioctl(VIDIOC_QUERYCAP, &capability) != 0 ||
+        strcmp(reinterpret_cast<const char*>(capability.driver), "iris_driver") != 0 ||
+        strcmp(reinterpret_cast<const char*>(capability.card), "Iris Encoder") != 0 ||
+        strcmp(reinterpret_cast<const char*>(capability.bus_info),
+               "plat:aa00000.video-codec:enc") != 0 ||
+        capability.version != 0x00070200 || capability.capabilities != 0x84204000 ||
+        capability.device_caps != 0x04204000) {
+        return false;
+    }
+
+    // Authenticate the loaded module, rather than a pathname or the generic
+    // iris_driver name shared by other devices and kernel builds.
+    static constexpr uint8_t kExpectedBuildIdNote[] = {
+        0x04, 0x00, 0x00, 0x00, 0x14, 0x00, 0x00, 0x00, 0x03, 0x00, 0x00, 0x00,
+        0x47, 0x4e, 0x55, 0x00, 0x99, 0x2a, 0x2f, 0x2c, 0x04, 0xc9, 0x51, 0x98,
+        0xeb, 0xe7, 0xab, 0x33, 0xc5, 0x4d, 0x54, 0x7b, 0xa3, 0xb3, 0x47, 0xa5,
+    };
+    ::base::ScopedFD noteFd(HANDLE_EINTR(::open(
+            "/sys/module/qcom_iris/notes/.note.gnu.build-id", O_RDONLY | O_CLOEXEC | O_NOFOLLOW)));
+    uint8_t note[sizeof(kExpectedBuildIdNote) + 1] = {};
+    if (!noteFd.is_valid() ||
+        HANDLE_EINTR(::read(noteFd.get(), note, sizeof(note))) !=
+                static_cast<ssize_t>(sizeof(kExpectedBuildIdNote)) ||
+        memcmp(note, kExpectedBuildIdNote, sizeof(kExpectedBuildIdNote)) != 0) {
+        return false;
+    }
+
+    struct v4l2_queryctrl query = {};
+    query.id = V4L2_CID_MPEG_VIDEO_HEVC_TIER;
+    errno = 0;
+    if (ioctl(VIDIOC_QUERYCTRL, &query) >= 0 || errno != EINVAL) return false;
+    struct v4l2_control actual = {};
+    actual.id = V4L2_CID_MPEG_VIDEO_HEVC_TIER;
+    errno = 0;
+    return ioctl(VIDIOC_G_CTRL, &actual) < 0 && errno == EINVAL;
