+        auto queryMenu = [&device](uint32_t id, std::vector<uint32_t>* values,
+                                   int32_t* defaultValue) {
+            v4l2_queryctrl control = {};
+            control.id = id;
+            if (device->ioctl(VIDIOC_QUERYCTRL, &control) != 0 ||
+                control.type != V4L2_CTRL_TYPE_MENU ||
+                (control.flags & (V4L2_CTRL_FLAG_DISABLED | V4L2_CTRL_FLAG_READ_ONLY)) ||
+                control.minimum < 0 || control.maximum < control.minimum || control.maximum > 63) {
+                return false;
