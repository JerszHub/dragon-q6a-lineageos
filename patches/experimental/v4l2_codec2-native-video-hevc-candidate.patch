diff --git a/tests/host/run_hevc_geometry_rate.py b/tests/host/run_hevc_geometry_rate.py
new file mode 100644
index 0000000..c3a80b1
--- /dev/null
+++ b/tests/host/run_hevc_geometry_rate.py
@@ -0,0 +1,85 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: BSD-3-Clause
+"""Compile the current HEVC rate publication and interface ceiling logic.
+
+The inputs are counterexamples to a geometry-independent rate limit. These
+unit checks do not measure encoder throughput or establish a driver limit.
+"""
+from pathlib import Path
+import argparse
+import os
+import re
+import shutil
+import subprocess
+import tempfile
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--cxx', default=os.environ.get('CXX', 'g++'))
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parents[2]
+    device = (root / 'v4l2/V4L2Device.cpp').read_text()
+    interface = (root / 'components/EncodeInterface.cpp').read_text()
+    start = device.index('        if (intervalsComplete && fastestNumerator && fastestDenominator) {')
+    end = device.index('        caps.supportedProfiles.push_back(profile);', start)
+    publication = device[start:end]
+    if device.rfind('if (codec == VideoCodec::HEVC)', 0, start) < 0:
+        raise RuntimeError('Rate publication is not in the HEVC branch')
+    constant = re.search(r'constexpr uint32_t kHEVCImplementationMaxFramerate = \d+;', interface)
+    maximum = re.search(r'const double maximum = mHEVCQueriedMaxFramerate > 0[\s\S]+?;', interface)
+    if not constant or not maximum:
+        raise RuntimeError('Current HEVC implementation ceiling expression is unavailable')
+    source = '''
+#include <algorithm>
+#include <cassert>
+#include <cstdint>
+#include <cstdio>
+#define ALOGI(...) ((void)0)
+struct Profile {
+    struct Size { int width; int height; } max_resolution;
+    uint32_t max_framerate_numerator = 0;
+    uint32_t max_framerate_denominator = 0;
+};
+''' + constant.group() + '''
+void publish(Profile& profile, bool intervalsComplete,
+             uint32_t fastestNumerator, uint32_t fastestDenominator) {
+''' + publication + '''
+}
+double ceiling(const Profile& profile) {
+    const double mHEVCQueriedMaxFramerate = profile.max_framerate_numerator && profile.max_framerate_denominator
+            ? static_cast<double>(profile.max_framerate_numerator) / profile.max_framerate_denominator : 0;
+''' + maximum.group() + '''
+    return maximum;
+}
+int main() {
+    for (uint32_t rate : {0u, 8u, 65u, 480u}) {
+        for (bool complete : {false, true}) {
+            Profile profile{{8192, 8192}};
+            publish(profile, complete, rate, rate ? 1 : 0);
+            assert(profile.max_resolution.width == 8192 && profile.max_resolution.height == 8192);
+            assert(profile.max_framerate_numerator == 0 && profile.max_framerate_denominator == 0);
+            assert(ceiling(profile) == 30);
+        }
+    }
+    // A genuinely geometry-independent profile rate may still reduce the
+    // implementation ceiling. The getter expression retains this behavior.
+    Profile explicitRate{{3840, 2160}, 24, 1};
+    assert(ceiling(explicitRate) == 24);
+    std::puts("PASS: geometry-specific intervals do not become a global HEVC rate cap");
+}
+'''
+    compiler = shutil.which(args.cxx)
+    if compiler is None:
+        raise RuntimeError('A host C++17 compiler is required')
+    with tempfile.TemporaryDirectory(prefix='hevc-geometry-rate-') as temporary:
+        folder = Path(temporary)
+        path, binary = folder / 'rate.cpp', folder / 'rate'
+        path.write_text(source)
+        subprocess.run([compiler, '-std=c++17', '-O2', '-Wall', '-Wextra', '-Werror',
+                        str(path), '-o', str(binary)], check=True, timeout=60)
+        subprocess.run([str(binary)], check=True, timeout=10)
+
+
+if __name__ == '__main__':
+    main()
