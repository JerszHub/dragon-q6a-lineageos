diff --git a/common/HEVCEncoderHeaders.cpp b/common/HEVCEncoderHeaders.cpp
new file mode 100644
index 0000000..ec4bb7d
--- /dev/null
+++ b/common/HEVCEncoderHeaders.cpp
@@ -0,0 +1,257 @@
+// Copyright 2026 Q6A native video contributors.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <v4l2_codec2/common/HEVCEncoderHeaders.h>
+
+#include <algorithm>
+#include <iterator>
+#include <limits>
+#include <utility>
+
+namespace android {
+namespace {
+
+// Read EBSP directly, removing emulation-prevention bytes without allocating
+// a copy proportional to the (potentially large) encoded picture.
+class Bits {
+public:
+    Bits(const uint8_t* data, size_t size) : mData(data), mSize(size) {}
+    bool read(unsigned count, uint32_t* value) {
+        if (count > 32) return false;
+        *value = 0;
+        for (unsigned bit = 0; bit < count; ++bit) {
+            if (!mRemaining) {
+                if (mPosition == mSize) return false;
+                uint8_t next = mData[mPosition++];
+                if (mZeros >= 2) {
+                    if (next == 3) {
+                        if (mPosition == mSize || mData[mPosition] > 3) return false;
+                        next = mData[mPosition++];
+                        mZeros = 0;
+                    } else if (next <= 2) {
+                        return false;
+                    }
+                }
+                mZeros = next == 0 ? mZeros + 1 : 0;
+                mByte = next;
+                mRemaining = 8;
+            }
+            *value = (*value << 1) | ((mByte >> --mRemaining) & 1);
+        }
+        return true;
+    }
+    bool skip(unsigned count) {
+        uint32_t ignored;
+        while (count) {
+            unsigned step = std::min(count, 32u);
+            if (!read(step, &ignored)) return false;
+            count -= step;
+        }
+        return true;
+    }
+    bool ue(uint32_t* value) {
+        uint32_t bit;
+        unsigned zeros = 0;
+        while (true) {
+            if (!read(1, &bit)) return false;
+            if (bit) break;
+            if (++zeros > 31) return false;
+        }
+        uint32_t suffix = 0;
+        if (!read(zeros, &suffix)) return false;
+        uint64_t result = ((uint64_t{1} << zeros) - 1) + suffix;
+        if (result > std::numeric_limits<uint32_t>::max()) return false;
+        *value = static_cast<uint32_t>(result);
+        return true;
+    }
+private:
+    const uint8_t* mData;
+    size_t mSize;
+    size_t mPosition = 0;
+    unsigned mZeros = 0;
+    unsigned mRemaining = 0;
+    uint8_t mByte = 0;
+};
+
+struct NAL {
+    const uint8_t* data;
+    size_t size;
+    uint8_t type;
+};
+
+bool startCode(const uint8_t* data, size_t size, size_t offset, size_t* length) {
+    if (size - offset >= 4 && data[offset] == 0 && data[offset + 1] == 0 &&
+        data[offset + 2] == 0 && data[offset + 3] == 1) {
+        *length = 4;
+        return true;
+    }
+    if (size - offset >= 3 && data[offset] == 0 && data[offset + 1] == 0 &&
+        data[offset + 2] == 1) {
+        *length = 3;
+        return true;
+    }
+    return false;
+}
+
+bool split(const uint8_t* data, size_t size, std::vector<NAL>* nals) {
+    if (!data || !size || size > HEVCEncoderHeaders::kMaxPacketBytes) return false;
+    size_t position = 0, prefix = 0;
+    while (position < size && !startCode(data, size, position, &prefix)) {
+        if (data[position++] != 0) return false;
+    }
+    if (position == size) return false;
+    while (position < size) {
+        if (!startCode(data, size, position, &prefix)) return false;
+        size_t begin = position + prefix;
+        position = begin;
+        while (position < size && !startCode(data, size, position, &prefix)) ++position;
+        size_t end = position;
+        while (end > begin && data[end - 1] == 0) --end;  // trailing_zero_8bits
+        if (end - begin < 3 || nals->size() == HEVCEncoderHeaders::kMaxNalUnits) return false;
+        const uint8_t* nal = data + begin;
+        // No forbidden bit, no multilayer output, and temporal_id_plus1 != 0.
+        if ((nal[0] & 0x81) || (nal[1] & 0xf8) || !(nal[1] & 7)) return false;
+        nals->push_back({nal, end - begin, static_cast<uint8_t>((nal[0] >> 1) & 63)});
+    }
+    return !nals->empty();
+}
+
+bool profileTierLevel(Bits* bits, uint32_t layers, uint8_t expectedLevelIdc,
+                      uint32_t* levelIdc) {
+    uint32_t space, tier, profile;
+    if (layers > 6 || !bits->read(2, &space) || !bits->read(1, &tier) || !bits->read(5, &profile) ||
+        space != 0 || tier != 0 || profile != 1 || !bits->skip(32 + 48) ||
+        !bits->read(8, levelIdc)) return false;
+    constexpr uint8_t knownLevels[] = {30, 60, 63, 90, 93, 120, 123, 150, 153, 156, 180, 183, 186};
+    if (std::find(std::begin(knownLevels), std::end(knownLevels), *levelIdc) == std::end(knownLevels) ||
+        (expectedLevelIdc && *levelIdc != expectedLevelIdc)) return false;
+    uint32_t profiles[6] = {}, levels[6] = {};
+    for (uint32_t i = 0; i < layers; ++i) {
+        if (!bits->read(1, &profiles[i]) || !bits->read(1, &levels[i])) return false;
+    }
+    if (layers && !bits->skip(2 * (8 - layers))) return false;
+    for (uint32_t i = 0; i < layers; ++i) {
+        if ((profiles[i] && !bits->skip(88)) || (levels[i] && !bits->skip(8))) return false;
+    }
+    return true;
+}
+
+bool vpsInfo(const NAL& nal, uint32_t* vpsId, uint8_t expectedLevelIdc,
+             uint32_t* levelIdc) {
+    Bits bits(nal.data + 2, nal.size - 2);
+    uint32_t baseFlags, maxLayers, layers, reserved;
+    // Only a self-contained single-layer Main stream is supported. These
+    // fields precede the VPS PTL; accepting an ID alone does not establish tier.
+    return bits.read(4, vpsId) && bits.read(2, &baseFlags) && baseFlags == 3 &&
+           bits.read(6, &maxLayers) && maxLayers == 0 && bits.read(3, &layers) &&
+           bits.skip(1) && bits.read(16, &reserved) && reserved == 0xffff &&
+           profileTierLevel(&bits, layers, expectedLevelIdc, levelIdc);
+}
+
+bool spsInfo(const NAL& nal, uint32_t* vpsId, uint32_t* spsId,
+             uint32_t expectedWidth, uint32_t expectedHeight,
+             uint8_t expectedLevelIdc, uint32_t* levelIdc) {
+    Bits bits(nal.data + 2, nal.size - 2);
+    uint32_t layers, unused;
+    if (!bits.read(4, vpsId) || !bits.read(3, &layers) || !bits.skip(1) ||
+        !profileTierLevel(&bits, layers, expectedLevelIdc, levelIdc)) return false;
+    uint32_t chroma, width, height, crop;
+    if (!bits.ue(spsId) || *spsId > 15 || !bits.ue(&chroma) || chroma != 1 ||
+        !bits.ue(&width) || !bits.ue(&height) || !width || !height ||
+        width > 16384 || height > 16384 || !bits.read(1, &crop)) return false;
+    uint32_t left = 0, right = 0, top = 0, bottom = 0;
+    if (crop && (!bits.ue(&left) || !bits.ue(&right) || !bits.ue(&top) || !bits.ue(&bottom))) return false;
+    uint64_t horizontal = 2 * (uint64_t{left} + right);
+    uint64_t vertical = 2 * (uint64_t{top} + bottom);
+    if (horizontal >= width || vertical >= height ||
+        (expectedWidth && width - horizontal != expectedWidth) ||
+        (expectedHeight && height - vertical != expectedHeight)) return false;
+    // The implementation exposes Main 8-bit 4:2:0 only, never Main10.
+    return bits.ue(&unused) && unused == 0 && bits.ue(&unused) && unused == 0;
+}
+
+bool sameOrEmpty(const std::vector<uint8_t>& stored, const NAL& nal) {
+    return stored.empty() || (stored.size() == nal.size &&
+                              std::equal(stored.begin(), stored.end(), nal.data));
+}
+
+void append(std::vector<uint8_t>* csd, const std::vector<uint8_t>& nal) {
+    csd->insert(csd->end(), {0, 0, 0, 1});
+    csd->insert(csd->end(), nal.begin(), nal.end());
+}
+
+}  // namespace
+
+void HEVCEncoderHeaders::reset(uint32_t expectedWidth, uint32_t expectedHeight,
+                              uint8_t expectedLevelIdc) {
+    mVPS.clear();
+    mSPS.clear();
+    mPPS.clear();
+    mVPSId = mSPSVPSId = mSPSId = mPPSSPSId = mPPSId = 0;
+    mExpectedWidth = expectedWidth;
+    mExpectedHeight = expectedHeight;
+    mExpectedLevelIdc = expectedLevelIdc;
+    mVPSLevelIdc = mSPSLevelIdc = 0;
+    mDelivered = false;
+}
+
+void HEVCEncoderHeaders::flush() {
+    if (!mDelivered) reset(mExpectedWidth, mExpectedHeight, mExpectedLevelIdc);
+}
+
+HEVCEncoderHeaders::Result HEVCEncoderHeaders::process(
+        const uint8_t* data, size_t size, std::vector<uint8_t>* csd) {
+    if (!csd) return Result::kError;
+    csd->clear();
+    std::vector<NAL> nals;
+    if (!split(data, size, &nals)) return Result::kError;
+    HEVCEncoderHeaders pending = *this;
+    bool frame = false;
+    for (const NAL& nal : nals) {
+        if (nal.type >= 32 && nal.type <= 34) {
+            // Parameter sets must precede picture data, including within one callback.
+            if (frame || nal.size > kMaxParameterSetBytes) return Result::kError;
+            Bits bits(nal.data + 2, nal.size - 2);
+            if (nal.type == 32) {
+                if (!sameOrEmpty(pending.mVPS, nal) ||
+                    !vpsInfo(nal, &pending.mVPSId, mExpectedLevelIdc, &pending.mVPSLevelIdc)) return Result::kError;
+                pending.mVPS.assign(nal.data, nal.data + nal.size);
+            } else if (nal.type == 33) {
+                if (!sameOrEmpty(pending.mSPS, nal) ||
+                    !spsInfo(nal, &pending.mSPSVPSId, &pending.mSPSId, mExpectedWidth, mExpectedHeight,
+                             mExpectedLevelIdc, &pending.mSPSLevelIdc)) return Result::kError;
+                pending.mSPS.assign(nal.data, nal.data + nal.size);
+            } else {
+                if (!sameOrEmpty(pending.mPPS, nal) || !bits.ue(&pending.mPPSId) || pending.mPPSId > 63 ||
+                    !bits.ue(&pending.mPPSSPSId) || pending.mPPSSPSId > 15) return Result::kError;
+                pending.mPPS.assign(nal.data, nal.data + nal.size);
+            }
+            if (!pending.mVPS.empty() && !pending.mSPS.empty() &&
+                pending.mVPSLevelIdc != pending.mSPSLevelIdc) return Result::kError;
+        } else if (nal.type <= 31) {
+            if (pending.mVPS.empty() || pending.mSPS.empty() || pending.mPPS.empty() ||
+                pending.mVPSId != pending.mSPSVPSId || pending.mSPSId != pending.mPPSSPSId ||
+                pending.mVPSLevelIdc != pending.mSPSLevelIdc) return Result::kError;
+            Bits bits(nal.data + 2, nal.size - 2);
+            uint32_t firstSlice, ppsId;
+            if (!bits.read(1, &firstSlice) || (!frame && !firstSlice) || (frame && firstSlice) ||
+                (nal.type >= 16 && nal.type <= 23 && !bits.skip(1)) ||
+                !bits.ue(&ppsId) || ppsId != pending.mPPSId) return Result::kError;
+            frame = true;
+        } else if (nal.type > 40) {
+            return Result::kError;  // reserved/unspecified output is not an encoded frame
+        }
+    }
+    if (frame && !pending.mDelivered) {
+        csd->reserve(pending.mVPS.size() + pending.mSPS.size() + pending.mPPS.size() + 12);
+        append(csd, pending.mVPS);
+        append(csd, pending.mSPS);
+        append(csd, pending.mPPS);
+        pending.mDelivered = true;
+    }
+    *this = std::move(pending);
+    return frame ? Result::kFrame : Result::kHeaderOnly;
+}
+
+}  // namespace android
