@@ -0,0 +1,63 @@
+// Copyright 2026 Q6A native video contributors.
+// SPDX-License-Identifier: MIT
+// Replay externally authenticated driver CAPTURE callbacks against the actual
+// HEVCEncoderHeaders implementation. This is a host logic check, not an Android
+// component build, hardware workload, decoder or throughput measurement.
+#include <v4l2_codec2/common/HEVCEncoderHeaders.h>
+
+#include <cassert>
+#include <cstdint>
+#include <fstream>
+#include <iostream>
+#include <iterator>
+#include <vector>
+
+// Restricted hosts may hide /proc/<pid>/task. ASan/UBSan remain active; no
+// LeakSanitizer result is claimed. Harmless when a different compiler is used.
+extern "C" int __lsan_is_turned_off() { return 1; }
+
+int main(int argc, char** argv) {
+    assert(argc == 3);
+    std::ifstream input(argv[1], std::ios::binary), ledger(argv[2]);
+    assert(input && ledger);
+    const std::vector<uint8_t> bytes((std::istreambuf_iterator<char>(input)), {});
+    assert(!bytes.empty() && bytes.size() <= 16 * 1024 * 1024);
+
+    android::HEVCEncoderHeaders parser;
+    parser.reset(3840, 2160, 153);  // Fixed captured Main5.1 trial configuration.
+    std::vector<uint8_t> csd;
+    uint64_t declaredOffset, count, flags, pts;
+    size_t offset = 0, callbacks = 0, frames = 0, configurations = 0, emptyLast = 0;
+    while (ledger >> declaredOffset >> count >> flags >> pts) {
+        assert(callbacks < 128 && declaredOffset == offset && count <= bytes.size() - offset);
+        assert(!(flags & 0x40));  // Original driver ERROR flag must be absent.
+        if (count == 0) {
+            // The observed empty LAST callback is drain completion, not a
+            // picture. Its old timestamp must never enter the frame matcher.
+            assert(flags & 0x00100000);
+            assert(offset == bytes.size());
+            ++emptyLast;
+        } else {
+            assert(emptyLast == 0 && !(flags & 0x00100000));
+            const auto result = parser.process(bytes.data() + offset, count, &csd);
+            // The fixed fixture joins VPS/SPS/PPS with the initial picture;
+            // each nonempty CAPTURE callback represents exactly one picture.
+            assert(result == android::HEVCEncoderHeaders::Result::kFrame);
+            assert(frames < 32 && pts == frames * 1000000ULL / 30);
+            if (!csd.empty()) {
+                ++configurations;
+                assert(frames == 0 && parser.levelIdc() == 153);
+            } else {
+                assert(frames > 0);
+            }
+            ++frames;
+        }
+        offset += static_cast<size_t>(count);
+        ++callbacks;
+    }
+    assert(ledger.eof());
+    assert(offset == bytes.size() && callbacks == 33 && emptyLast == 1 && frames == 32 &&
+           configurations == 1 && parser.levelIdc() == 153);
+    std::cout << "PASS: actual HEVC header source accepted captured Main5.1 driver output: "
+                 "32 pictures, one CSD, joined initial parameter sets, one empty LAST\n";
+}
diff --git a/tests/host/ColorConversion_test.cpp b/tests/host/ColorConversion_test.cpp
new file mode 100644
index 0000000..efc920f
--- /dev/null
+++ b/tests/host/ColorConversion_test.cpp
@@ -0,0 +1,128 @@
+// SPDX-License-Identifier: MIT
+// Host contract tests: exact equality to the retained Q6A helper, not a lossy
+// quality threshold or a claim of Android/ARM64 runtime validation.
+#include <v4l2_codec2/common/ColorConversion.h>
+#include <algorithm>
+#include <cassert>
+#include <cstdint>
+#include <iostream>
+#include <limits>
+#include <random>
+#include <vector>
+
+extern "C" int q6a_abgr_to_i420_bt709(const uint8_t*, int, uint8_t*, int,
+                                     uint8_t*, int, uint8_t*, int, int, int);
+// This sandbox cannot enumerate proc task lists for LeakSanitizer. Address and
+// undefined-behavior instrumentation remain enabled by the host runner.
+extern "C" const char* __asan_default_options() { return "detect_leaks=0"; }
+
+namespace {
+constexpr uint8_t kCanary = 0xa7;
+constexpr size_t kGuard = 32;
+struct Plane {
+    int rowBytes;
+    int rows;
+    int stride;
+    std::vector<uint8_t> data;
+    Plane(int bytes, int count, int padding, bool negative)
+        : rowBytes(bytes), rows(count), stride((bytes + padding) * (negative ? -1 : 1)),
+          data(kGuard * 2 + static_cast<size_t>(bytes + padding) * (count - 1) + bytes, kCanary) {}
+    uint8_t* pointer() {
+        return data.data() + kGuard + (stride < 0 ? static_cast<size_t>(rows - 1) * -stride : 0);
+    }
+    bool paddingUntouched() const {
+        const size_t pitch = static_cast<size_t>(stride < 0 ? -stride : stride);
+        for (size_t i = 0; i < data.size(); ++i) {
+            const bool active = i >= kGuard && i < data.size() - kGuard &&
+                                (i - kGuard) % pitch < static_cast<size_t>(rowBytes);
+            if (!active && data[i] != kCanary) return false;
+        }
+        return true;
+    }
+};
+size_t cases = 0;
+void equalCase(int width, int height, int padding, unsigned signs, std::mt19937& random) {
+    const int rows = height < 0 ? -height : height;
+    const int cw = (width + 1) / 2, ch = (rows + 1) / 2;
+    Plane src(width * 4, rows, padding, signs & 1);
+    for (auto& value : src.data) value = static_cast<uint8_t>(random());
+    const auto unchanged = src.data;
+    Plane y(width, rows, padding + 1, signs & 2), u(cw, ch, padding + 2, signs & 4),
+          v(cw, ch, padding + 3, signs & 8);
+    Plane ry = y, ru = u, rv = v;
+    assert(q6a_abgr_to_i420_bt709(src.pointer(), src.stride, ry.pointer(), ry.stride,
+                                ru.pointer(), ru.stride, rv.pointer(), rv.stride, width, height) == 0);
+    assert(android::rgbaToI420BT709Limited(src.pointer(), src.stride, y.pointer(), y.stride,
+                                         u.pointer(), u.stride, v.pointer(), v.stride, width, height) == 0);
+    assert(y.data == ry.data && u.data == ru.data && v.data == rv.data);
+    assert(y.paddingUntouched() && u.paddingUntouched() && v.paddingUntouched());
+    assert(src.data == unchanged);
+    ++cases;
+}
+void knownColors() {
+    struct Color { uint8_t r, g, b, y, u, v; };
+    for (const auto& c : {Color{0,0,0,16,128,128}, Color{255,255,255,235,128,128},
+                          Color{255,0,0,63,102,240}, Color{0,255,0,173,42,26},
+                          Color{0,0,255,32,240,118}}) {
+        uint8_t rgba[16] = {c.r,c.g,c.b,0, c.r,c.g,c.b,255,
+                            c.r,c.g,c.b,123, c.r,c.g,c.b,7};
+        uint8_t y[4] = {}, u[1] = {}, v[1] = {};
+        assert(android::rgbaToI420BT709Limited(rgba,8,y,2,u,1,v,1,2,2) == 0);
+        for (auto value:y) assert(value == c.y);
+        assert(u[0] == c.u && v[0] == c.v);
+        // The existing NV12 MergeUVPlane path receives U first, then V.
+        const uint8_t nv12[2] = {u[0],v[0]};
+        assert(nv12[0] == c.u && nv12[1] == c.v);
+        ++cases;
+    }
+}
+void invalidInputs() {
+    std::vector<uint8_t> src(256, 19), y(256,kCanary), u(256,kCanary), v(256,kCanary);
+    auto reject = [&](const uint8_t* s, int ss, uint8_t* yy, int ys,
+                      uint8_t* uu, int us, uint8_t* vv, int vs, int width, int height) {
+        const auto oldSrc=src, oldY=y, oldU=u, oldV=v;
+        assert(android::rgbaToI420BT709Limited(s,ss,yy,ys,uu,us,vv,vs,width,height) == -1);
+        assert(src==oldSrc && y==oldY && u==oldU && v==oldV);
+        ++cases;
+    };
+    const int imin=std::numeric_limits<int>::min();
+    reject(nullptr,8,y.data(),2,u.data(),1,v.data(),1,2,2);
+    reject(src.data(),8,nullptr,2,u.data(),1,v.data(),1,2,2);
+    reject(src.data(),8,y.data(),2,nullptr,1,v.data(),1,2,2);
+    reject(src.data(),8,y.data(),2,u.data(),1,nullptr,1,2,2);
+    for (int width : {0,-1,8193,std::numeric_limits<int>::max()})
+        reject(src.data(),8,y.data(),2,u.data(),1,v.data(),1,width,2);
+    for (int height : {0,-8193,8193,imin,std::numeric_limits<int>::max()})
+        reject(src.data(),8,y.data(),2,u.data(),1,v.data(),1,2,height);
+    reject(src.data(),7,y.data(),2,u.data(),1,v.data(),1,2,2);
+    reject(src.data(),8,y.data(),1,u.data(),1,v.data(),1,2,2);
+    reject(src.data(),8,y.data(),2,u.data(),0,v.data(),1,2,2);
+    reject(src.data(),8,y.data(),2,u.data(),1,v.data(),0,2,2);
+    reject(src.data(),imin,y.data(),2,u.data(),1,v.data(),1,2,2);
+    reject(src.data(),8,y.data(),imin,u.data(),1,v.data(),1,2,2);
+    reject(src.data(),8,y.data(),2,u.data(),imin,v.data(),1,2,2);
+    reject(src.data(),8,y.data(),2,u.data(),1,v.data(),imin,2,2);
+    reject(src.data(),8,src.data(),2,u.data(),1,v.data(),1,2,2);
+    reject(src.data(),8,y.data(),2,y.data()+1,1,v.data(),1,2,2);
+    reject(src.data(),8,y.data(),2,u.data(),1,u.data(),1,2,2);
+    reject(reinterpret_cast<const uint8_t*>(uintptr_t{1}),-8,y.data(),2,u.data(),1,v.data(),1,2,2);
+    reject(reinterpret_cast<const uint8_t*>(std::numeric_limits<uintptr_t>::max()-2),8,
+           y.data(),2,u.data(),1,v.data(),1,2,2);
+}
+}  // namespace
+int main() {
+    std::mt19937 random(0x709420);
+    knownColors();
+    for(int width : {1,2,3,7,15,16,17,31,32,33,63,64,65,127,128,129})
+        for(int height : {1,2,3,4,7,8})
+            for(int padding : {0,1,17})
+                for(unsigned signs : {0u,1u,2u,4u,8u,15u}) {
+                    equalCase(width,height,padding,signs,random);
+                    equalCase(width,-height,padding,signs,random);
+                }
+    equalCase(3840,2160,64,0,random);
+    equalCase(8192,2,0,0,random);
+    equalCase(2,8192,0,0,random);
+    invalidInputs();
+    std::cout << "PASS: " << cases << " fixed709 exact-reference, RGBA/UV, stride/edge, geometry/overlap and canary cases\n";
+}
diff --git a/tests/host/HevcHdrMetadata_test.cpp b/tests/host/HevcHdrMetadata_test.cpp
new file mode 100644
index 0000000..6b92693
--- /dev/null
+++ b/tests/host/HevcHdrMetadata_test.cpp
@@ -0,0 +1,131 @@
+// SPDX-License-Identifier: MIT
+// Host-only stream/lifetime tests; no Android libraries or video device.
+#include <v4l2_codec2/components/HevcHdrMetadata.h>
+
+#include <cassert>
+#include <cstdio>
+#include <vector>
+
+namespace {
+void put16(std::vector<uint8_t>& bytes, unsigned value) {
+    bytes.push_back(value >> 8);
+    bytes.push_back(value);
+}
+void put32(std::vector<uint8_t>& bytes, unsigned value) {
+    bytes.push_back(value >> 24);
+    bytes.push_back(value >> 16);
+    bytes.push_back(value >> 8);
+    bytes.push_back(value);
+}
+std::vector<uint8_t> sei(unsigned nits, unsigned cll) {
+    std::vector<uint8_t> rbsp{137, 24};
+    for (unsigned value : {13250u, 34500u, 7500u, 3000u, 34000u, 16000u, 15635u, 16450u}) {
+        put16(rbsp, value);
+    }
+    put32(rbsp, nits * 10000u);
+    put32(rbsp, 50);
+    rbsp.push_back(144);
+    rbsp.push_back(4);
+    put16(rbsp, cll);
+    put16(rbsp, 400);
+    rbsp.push_back(0x80);
+    std::vector<uint8_t> bytes{0, 0, 0, 1, 78, 1};
+    unsigned zeros = 0;
+    for (uint8_t value : rbsp) {
+        if (zeros >= 2 && value <= 3) {
+            bytes.push_back(3);
+            zeros = 0;
+        }
+        bytes.push_back(value);
+        zeros = value == 0 ? zeros + 1 : 0;
+    }
+    return bytes;
+}
+std::vector<uint8_t> hvcc(const std::vector<uint8_t>& annex) {
+    std::vector<uint8_t> bytes(23, 0);
+    bytes[0] = 1;
+    bytes[21] = 3;
+    bytes[22] = 1;
+    bytes.push_back(39);
+    put16(bytes, 1);
+    put16(bytes, annex.size() - 4);
+    bytes.insert(bytes.end(), annex.begin() + 4, annex.end());
+    return bytes;
+}
+std::vector<uint8_t> lengthPrefixed(const std::vector<uint8_t>& annex) {
+    std::vector<uint8_t> bytes;
+    put32(bytes, annex.size() - 4);
+    bytes.insert(bytes.end(), annex.begin() + 4, annex.end());
+    return bytes;
+}
+}
+
+int main() {
+    using android::HevcHdrMetadata;
+    const std::vector<uint8_t> ordinary{0, 0, 0, 1, 2, 1, 0x80};
+    const std::vector<uint8_t> csd{0, 0, 0, 1, 64, 1, 0x80};
+    const auto first = sei(1000, 1000);
+    const auto second = sei(2000, 2200);
+    HevcHdrMetadata tracker;
+    int parsed;
+    assert(tracker.recordInput(0, ordinary.data(), ordinary.size(), false, &parsed));
+    assert(parsed == 0 && !tracker.snapshot(0));
+    tracker.forget(0);
+    assert(tracker.recordInput(1, first.data(), first.size(), false, &parsed));
+    assert(parsed == (Q6A_HDR_MDCV | Q6A_HDR_CLLI));
+    const auto retained = tracker.snapshot(1);
+    assert(retained && retained->max_luminance == 1000.f && retained->max_cll == 1000.f);
+    assert(retained->red_x == 34000.f / 50000.f);
+    assert(retained->green_x == 13250.f / 50000.f);
+    assert(retained->blue_x == 7500.f / 50000.f);
+    assert(tracker.recordInput(2, second.data(), second.size(), false, &parsed));
+    assert(tracker.snapshot(2)->max_luminance == 2000.f);
+    assert(tracker.snapshot(1)->max_luminance == 1000.f); // reordered output is immutable
+    assert(tracker.recordInput(3, first.data(), first.size() - 1, false, &parsed));
+    assert(parsed < 0 && tracker.snapshot(3)->max_luminance == 2000.f);
+    assert(tracker.recordInput(4, ordinary.data(), ordinary.size(), false, &parsed));
+    assert(tracker.snapshot(4)->max_cll == 2200.f);
+    assert(!tracker.recordInput(4, first.data(), first.size(), false, &parsed));
+    assert(tracker.snapshot(4)->max_cll == 2200.f);
+
+    // A new CSD run clears stale HDR; earlier in-flight pictures retain theirs.
+    assert(tracker.recordInput(5, csd.data(), csd.size(), true, &parsed));
+    assert(!tracker.snapshot(5));
+    assert(tracker.snapshot(1)->max_luminance == 1000.f);
+    assert(tracker.recordInput(6, first.data(), first.size(), true, &parsed));
+    assert(tracker.recordInput(7, csd.data(), csd.size(), true, &parsed));
+    assert(tracker.snapshot(7)->max_luminance == 1000.f); // consecutive CSD is not reset twice
+    tracker.reset();
+    assert(tracker.pendingSnapshots() == 0 && !tracker.snapshot(7));
+    assert(retained->max_luminance == 1000.f); // value survives the originating stream
+    assert(tracker.recordInput(8, ordinary.data(), ordinary.size(), false, &parsed));
+    assert(!tracker.snapshot(8));
+
+    // hvcC length width is remembered for actual length-prefixed access units.
+    tracker.reset();
+    auto config = hvcc(first);
+    assert(tracker.recordInput(9, config.data(), config.size(), true, &parsed));
+    assert(tracker.snapshot(9)->max_luminance == 1000.f);
+    auto access = lengthPrefixed(second);
+    assert(tracker.recordInput(10, access.data(), access.size(), false, &parsed));
+    assert(tracker.snapshot(10)->max_cll == 2200.f);
+    access.pop_back();
+    assert(tracker.recordInput(11, access.data(), access.size(), false, &parsed));
+    assert(parsed < 0 && tracker.snapshot(11)->max_cll == 2200.f);
+    assert(tracker.recordInput(12, first.data(), Q6A_HDR_MAX_INPUT + 1u, false, &parsed));
+    assert(parsed == Q6A_HDR_LIMIT && tracker.snapshot(12)->max_cll == 2200.f);
+    assert(tracker.recordInput(13, nullptr, 0, false, &parsed));
+    assert(tracker.snapshot(13)->max_cll == 2200.f);
+
+    tracker.reset();
+    for (size_t i = 0; i < HevcHdrMetadata::kMaxSnapshots; ++i) {
+        assert(tracker.recordInput(i, ordinary.data(), ordinary.size(), false, &parsed));
+    }
+    assert(!tracker.recordInput(1000, ordinary.data(), ordinary.size(), false, &parsed));
+    tracker.forget(0);
+    assert(tracker.recordInput(1000, ordinary.data(), ordinary.size(), false, &parsed));
+    HevcHdrMetadata other;
+    assert(other.recordInput(1, ordinary.data(), ordinary.size(), false, &parsed));
+    assert(!other.snapshot(1));
+    std::puts("PASS: HEVC HDR snapshots, reordering, malformed input, hvcC, new CSD, lifecycle and bounds");
+}
