index 0000000..d8b3ce7
--- /dev/null
+++ b/common/ColorConversion.cpp
@@ -0,0 +1,244 @@
+// SPDX-License-Identifier: MIT
+// Fixed BT.709 limited-range source port of the Q6A helper_709.c compatibility
+// converter. The Q16/Q18 arithmetic and AArch64 load/NEON operations below are
+// retained from the helper validated by the native Surface regression.
+// This is a fixed RGBA-byte-order converter, not general color negotiation.
+
+#include <v4l2_codec2/common/ColorConversion.h>
+
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#if defined(__aarch64__)
+#include <arm_neon.h>
+#endif
+
+namespace android {
+namespace {
+typedef unsigned char u8;
+
+static inline int bounded_byte(int value) {
+    return value < 0 ? 0 : value > 255 ? 255 : value;
+}
+
+static inline u8 scalar_y(const u8 *p) {
+    return (u8)bounded_byte((1081344 + 11966 * p[0] +
+                            40254 * p[1] + 4064 * p[2]) >> 16);
+}
+
+#if defined(__aarch64__)
+/* Y uses unsigned 16x16-to-32 products: coefficient 40254 deliberately does
+ * not fit signed16. At R/G/B<=255 the accumulator is in [1081344,15433764],
+ * so its rounded >>16 result is in [16,235] and narrowing cannot saturate.
+ */
+/* This trial changes source loading only. Each of the four LD1 intrinsics
+ * reads exactly 16 contiguous bytes within the same 64-byte/16-pixel block.
+ * UZP separates alternating bytes without another source-memory access.
+ * Alpha is unused by the unchanged Y/U/V arithmetic, so val[3] is zero.
+ *
+ * This is a controlled load/deinterleave experiment, not a claim that LD4
+ * was the remaining bottleneck. The ARM64 load instructions are explicit
+ * so a compiler cannot fold the experiment back into interleaved LD4.
+ * The portable test branch models exactly the same four 16-byte loads.
+ */
+__attribute__((always_inline))
+static inline uint8x16x4_t load_rgba16_linear(const u8 *p) {
+    uint8x16_t q0, q1, q2, q3;
+#if defined(Q6A_PORTABLE_INTRINSICS)
+    q0 = vld1q_u8(p);
+    q1 = vld1q_u8(p + 16);
+    q2 = vld1q_u8(p + 32);
+    q3 = vld1q_u8(p + 48);
+#else
+    __asm__ volatile(
+        "ldp %q0, %q1, [%4]\n"
+        "ldp %q2, %q3, [%4, #32]"
+        : "=&w" (q0), "=&w" (q1), "=&w" (q2), "=&w" (q3)
+        : "r" (p)
+        : "memory");
+#endif
+    uint8x16_t rb_lo = vuzp1q_u8(q0, q1);
+    uint8x16_t ga_lo = vuzp2q_u8(q0, q1);
+    uint8x16_t rb_hi = vuzp1q_u8(q2, q3);
+    uint8x16_t ga_hi = vuzp2q_u8(q2, q3);
+    uint8x16x4_t rgb;
+    rgb.val[0] = vuzp1q_u8(rb_lo, rb_hi);
+    rgb.val[1] = vuzp1q_u8(ga_lo, ga_hi);
+    rgb.val[2] = vuzp2q_u8(rb_lo, rb_hi);
+    rgb.val[3] = vdupq_n_u8(0);
+    return rgb;
+}
+
+__attribute__((always_inline))
+static inline uint8x8_t vector_y8(uint8x8_t r, uint8x8_t g, uint8x8_t b) {
+    uint16x8_t rr = vmovl_u8(r);
+    uint16x8_t gg = vmovl_u8(g);
+    uint16x8_t bb = vmovl_u8(b);
+    uint32x4_t low = vmull_n_u16(vget_low_u16(rr), 11966);
+    uint32x4_t high = vmull_n_u16(vget_high_u16(rr), 11966);
+    low = vmlal_n_u16(low, vget_low_u16(gg), 40254);
+    high = vmlal_n_u16(high, vget_high_u16(gg), 40254);
+    low = vmlal_n_u16(low, vget_low_u16(bb), 4064);
+    high = vmlal_n_u16(high, vget_high_u16(bb), 4064);
+    low = vaddq_u32(low, vdupq_n_u32(1081344));
+    high = vaddq_u32(high, vdupq_n_u32(1081344));
+    return vmovn_u16(vcombine_u16(vshrn_n_u32(low, 16),
+                                 vshrn_n_u32(high, 16)));
+}
+
+__attribute__((always_inline))
+static inline uint8x16_t vector_y16(uint8x16x4_t p) {
+    return vcombine_u8(
+        vector_y8(vget_low_u8(p.val[0]), vget_low_u8(p.val[1]),
+                  vget_low_u8(p.val[2])),
+        vector_y8(vget_high_u8(p.val[0]), vget_high_u8(p.val[1]),
+                  vget_high_u8(p.val[2])));
+}
+
+/* Each RGB sum covers four pixels and is in [0,1020], fitting signed16.
+ * U coefficients are (-6596,-22189,28784); V are (28784,-26145,-2639).
+ * Products and every partial/final sum fit signed32. Including 33685504
+ * (=128*2^18 + 2^17), the final numerator is positive and below 2^26.
+ * The >>18 result is in [16,240], exactly matching the original Q16
+ * averaging/rounding formula. SHRN32 has a maximum immediate of16, hence
+ * shift32 by18 first, then narrow; neither step changes valid result bits.
+ */
+__attribute__((always_inline))
+static inline uint8x8_t vector_chroma8(uint16x8_t r, uint16x8_t g,
+                                     uint16x8_t b, short cr, short cg,
+                                     short cb) {
+    int16x8_t rr = vreinterpretq_s16_u16(r);
+    int16x8_t gg = vreinterpretq_s16_u16(g);
+    int16x8_t bb = vreinterpretq_s16_u16(b);
+    int32x4_t low = vmull_n_s16(vget_low_s16(rr), cr);
+    int32x4_t high = vmull_n_s16(vget_high_s16(rr), cr);
+    low = vmlal_n_s16(low, vget_low_s16(gg), cg);
+    high = vmlal_n_s16(high, vget_high_s16(gg), cg);
+    low = vmlal_n_s16(low, vget_low_s16(bb), cb);
+    high = vmlal_n_s16(high, vget_high_s16(bb), cb);
+    low = vaddq_s32(low, vdupq_n_s32(33685504));
+    high = vaddq_s32(high, vdupq_n_s32(33685504));
+    return vmovn_u16(vreinterpretq_u16_s16(vcombine_s16(
+        vmovn_s32(vshrq_n_s32(low, 18)),
+        vmovn_s32(vshrq_n_s32(high, 18)))));
+}
+#endif
+
+
+struct PlaneSpan {
+    uintptr_t begin;
+    uintptr_t end;
+};
+
+// Validate the row footprint before any pointer arithmetic or output write.
+// The caller supplies mapped buffers spanning these rows; allocation lengths
+// cannot be inferred from raw pointers. Negative strides begin at the last row.
+bool planeSpan(const void* pointer, int stride, int rows, int rowBytes, PlaneSpan* span) {
+    if (stride == std::numeric_limits<int>::min()) return false;
+    const int64_t absoluteStride = stride < 0 ? -static_cast<int64_t>(stride) : stride;
+    if (absoluteStride < rowBytes) return false;
+    const uint64_t displacement = static_cast<uint64_t>(rows - 1) * absoluteStride;
+    if (displacement + rowBytes > static_cast<uint64_t>(std::numeric_limits<std::ptrdiff_t>::max())) {
+        return false;
+    }
+    const uintptr_t address = reinterpret_cast<uintptr_t>(pointer);
+    const uintptr_t maximum = std::numeric_limits<uintptr_t>::max();
+    if ((stride < 0 && address < displacement) ||
+        (stride >= 0 && address > maximum - displacement)) return false;
+    span->begin = stride < 0 ? address - displacement : address;
+    const uintptr_t last = stride < 0 ? address : address + displacement;
+    if (last > maximum - static_cast<uintptr_t>(rowBytes)) return false;
+    span->end = last + rowBytes;
+    return true;
+}
+
+bool overlaps(const PlaneSpan& a, const PlaneSpan& b) {
+    return a.begin < b.end && b.begin < a.end;
+}
+
+}  // namespace
+
+int rgbaToI420BT709Limited(const u8 *src, int src_stride,
+                         u8 *dst_y, int stride_y,
+                         u8 *dst_u, int stride_u,
+                         u8 *dst_v, int stride_v,
+                         int width, int height) {
+    if (!src || !dst_y || !dst_u || !dst_v || width < 1 || width > 8192 ||
+        height == 0 || height < -8192 || height > 8192) {
+        return -1;
+    }
+    const int rows = height < 0 ? -height : height;
+    const int chromaWidth = (width + 1) / 2;
+    const int chromaRows = (rows + 1) / 2;
+    PlaneSpan source, yPlane, uPlane, vPlane;
+    if (!planeSpan(src, src_stride, rows, width * 4, &source) ||
+        !planeSpan(dst_y, stride_y, rows, width, &yPlane) ||
+        !planeSpan(dst_u, stride_u, chromaRows, chromaWidth, &uPlane) ||
+        !planeSpan(dst_v, stride_v, chromaRows, chromaWidth, &vPlane) ||
+        overlaps(source, yPlane) || overlaps(source, uPlane) || overlaps(source, vPlane) ||
+        overlaps(yPlane, uPlane) || overlaps(yPlane, vPlane) || overlaps(uPlane, vPlane)) {
+        return -1;
+    }
+    if (height < 0) {
+        height = -height;
+        src += (std::ptrdiff_t)(height - 1) * src_stride;
+        src_stride = -src_stride;
+    }
+    for (int y = 0; y < height; y += 2) {
+        int second = y + 1 < height;
+        const u8 *row0 = src + (std::ptrdiff_t)y * src_stride;
+        const u8 *row1 = row0 + (second ? src_stride : 0);
+        u8 *out_y0 = dst_y + (std::ptrdiff_t)y * stride_y;
+        u8 *out_y1 = out_y0 + (second ? stride_y : 0);
+        u8 *out_u = dst_u + (std::ptrdiff_t)(y / 2) * stride_u;
+        u8 *out_v = dst_v + (std::ptrdiff_t)(y / 2) * stride_v;
+        int x = 0;
+#if defined(__aarch64__)
+        for (; x + 15 < width; x += 16) {
+            uint8x16x4_t a = load_rgba16_linear(row0 + (std::ptrdiff_t)x * 4);
+            uint8x16x4_t b = second ? load_rgba16_linear(row1 + (std::ptrdiff_t)x * 4) : a;
+            uint16x8_t r = vaddq_u16(vpaddlq_u8(a.val[0]),
+                                       vpaddlq_u8(b.val[0]));
+            uint16x8_t g = vaddq_u16(vpaddlq_u8(a.val[1]),
+                                       vpaddlq_u8(b.val[1]));
+            uint16x8_t blue = vaddq_u16(vpaddlq_u8(a.val[2]),
+                                          vpaddlq_u8(b.val[2]));
+            vst1q_u8(out_y0 + x, vector_y16(a));
+            if (second) {
+                vst1q_u8(out_y1 + x, vector_y16(b));
+            }
+            vst1_u8(out_u + x / 2, vector_chroma8(r, g, blue,
+                                                  -6596, -22189, 28784));
+            vst1_u8(out_v + x / 2, vector_chroma8(r, g, blue,
+                                                  28784, -26145, -2639));
+        }
+#endif
+        for (; x < width; x += 2) {
+            int next = x + 1 < width ? x + 1 : x;
+            const u8 *a = row0 + (std::ptrdiff_t)x * 4;
+            const u8 *b = row0 + (std::ptrdiff_t)next * 4;
+            const u8 *c = row1 + (std::ptrdiff_t)x * 4;
+            const u8 *d = row1 + (std::ptrdiff_t)next * 4;
+            int r = a[0] + b[0] + c[0] + d[0];
+            int g = a[1] + b[1] + c[1] + d[1];
+            int blue = a[2] + b[2] + c[2] + d[2];
+            out_y0[x] = scalar_y(a);
+            if (next != x) {
+                out_y0[next] = scalar_y(b);
+            }
+            if (second) {
+                out_y1[x] = scalar_y(c);
+                if (next != x) {
+                    out_y1[next] = scalar_y(d);
+                }
+            }
+            out_u[x / 2] = (u8)bounded_byte(
+                (33685504 - 6596 * r - 22189 * g + 28784 * blue) >> 18);
+            out_v[x / 2] = (u8)bounded_byte(
+                (33685504 + 28784 * r - 26145 * g - 2639 * blue) >> 18);
+        }
+    }
+    return 0;
+}
+
+}  // namespace android
