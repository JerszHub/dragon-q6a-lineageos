+            auto c2Level = v4L2LevelToC2Level(VideoCodec::HEVC, level);
+            if (c2HEVCLevelToV4L2(c2Level)) caps.supportedLevels.push_back(c2Level);
+        }
+        std::sort(caps.supportedLevels.begin(), caps.supportedLevels.end());
+        caps.supportedLevels.erase(std::unique(caps.supportedLevels.begin(), caps.supportedLevels.end()),
+                                   caps.supportedLevels.end());
+        SupportedProfile profile;
+        bool sizesComplete = false;
+        auto validDimension = [](uint32_t value) {
+            return value > 0 && value <= static_cast<uint32_t>(std::numeric_limits<int32_t>::max());
+        };
+        for (uint32_t index = 0; index < 64; ++index) {
+            v4l2_frmsizeenum size = {};
+            size.pixel_format = V4L2_PIX_FMT_HEVC;
+            size.index = index;
+            if (device->ioctl(VIDIOC_ENUM_FRAMESIZES, &size) != 0) {
+                sizesComplete = index > 0;
+                break;
+            }
+            if (size.type == V4L2_FRMSIZE_TYPE_STEPWISE || size.type == V4L2_FRMSIZE_TYPE_CONTINUOUS) {
+                const auto& step = size.stepwise;
+                if (validDimension(step.min_width) && validDimension(step.min_height) &&
+                    validDimension(step.max_width) && validDimension(step.max_height) &&
+                    step.max_width >= step.min_width && step.max_height >= step.min_height) {
+                    profile.min_resolution.set(step.min_width, step.min_height);
+                    profile.max_resolution.set(step.max_width, step.max_height);
+                    sizesComplete = true;
+                }
+                break;
+            }
+            if (size.type != V4L2_FRMSIZE_TYPE_DISCRETE ||
+                !validDimension(size.discrete.width) || !validDimension(size.discrete.height)) break;
+            const ui::Size current(size.discrete.width, size.discrete.height);
+            if (isEmpty(profile.min_resolution)) profile.min_resolution = current;
+            profile.min_resolution.setWidth(std::min(profile.min_resolution.width, current.width));
+            profile.min_resolution.setHeight(std::min(profile.min_resolution.height, current.height));
+            profile.max_resolution.setWidth(std::max(profile.max_resolution.width, current.width));
+            profile.max_resolution.setHeight(std::max(profile.max_resolution.height, current.height));
+        }
+        if (caps.supportedLevels.empty() || !sizesComplete) {
+            ALOGE("HEVC level or frame-size capabilities could not be queried");
+            caps.supportedLevels.clear();
+            return caps;
+        }
+        profile.profile = C2Config::PROFILE_HEVC_MAIN;
+        // Frame intervals describe one geometry, not a global profile bound.
+        // SupportedProfile has no geometry field for its rate limit. Keep this
+        // max-geometry query as a diagnostic; for example, 8 fps at 8192x8192
+        // must not cap a 3840x2160 configuration at 8 fps. The aggregate rate
+        // stays unknown, separate from EncodeInterface's explicit 30-fps
+        // implementation bound and strict runtime S/G_PARM rate checks.
+        uint32_t fastestNumerator = 0, fastestDenominator = 0;
+        bool intervalsComplete = false;
+        for (uint32_t index = 0; index < 64; ++index) {
+            v4l2_frmivalenum interval = {};
+            interval.pixel_format = V4L2_PIX_FMT_HEVC;
+            interval.width = profile.max_resolution.width;
+            interval.height = profile.max_resolution.height;
+            interval.index = index;
+            if (device->ioctl(VIDIOC_ENUM_FRAMEINTERVALS, &interval) != 0) {
+                intervalsComplete = index > 0;
+                break;
+            }
+            v4l2_fract value = {};
+            if (interval.type == V4L2_FRMIVAL_TYPE_DISCRETE) {
+                value = interval.discrete;
+            } else if (interval.type == V4L2_FRMIVAL_TYPE_STEPWISE ||
+                       interval.type == V4L2_FRMIVAL_TYPE_CONTINUOUS) {
+                value = interval.stepwise.min;  // Shortest interval = highest rate.
+                intervalsComplete = value.numerator && value.denominator;
+            } else {
+                break;
+            }
+            if (!value.numerator || !value.denominator) {
+                intervalsComplete = false;
+                break;
+            }
+            if (!fastestNumerator || static_cast<uint64_t>(value.denominator) * fastestDenominator >
+                    static_cast<uint64_t>(fastestNumerator) * value.numerator) {
+                fastestNumerator = value.denominator;
+                fastestDenominator = value.numerator;
+            }
+            if (interval.type != V4L2_FRMIVAL_TYPE_DISCRETE) break;
+        }
+        if (intervalsComplete && fastestNumerator && fastestDenominator) {
+            ALOGI("HEVC frame interval limit %u/%u fps applies only at %dx%d",
+                  fastestNumerator, fastestDenominator,
+                  profile.max_resolution.width, profile.max_resolution.height);
+        } else {
+            ALOGI("HEVC frame interval bound unknown; use explicit implementation limit and strict runtime rate checks");
+        }
+        profile.max_framerate_numerator = 0;
+        profile.max_framerate_denominator = 0;
+        caps.supportedProfiles.push_back(profile);
+        caps.defaultProfile = C2Config::PROFILE_HEVC_MAIN;
+        auto queriedDefault = v4L2LevelToC2Level(VideoCodec::HEVC, defaultLevel);
+        caps.defaultLevel = std::find(caps.supportedLevels.begin(), caps.supportedLevels.end(),
+                                     queriedDefault) != caps.supportedLevels.end()
+                                    ? queriedDefault : caps.supportedLevels.front();
+        return caps;
+    }
     caps.supportedProfiles = V4L2Device::getSupportedProfiles(
             V4L2Device::Type::kEncoder, {V4L2Device::videoCodecToPixFmt(codec)});
     return caps;
