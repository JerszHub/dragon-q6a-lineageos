diff --git a/tests/host/run_captured_hevc_driver.py b/tests/host/run_captured_hevc_driver.py
new file mode 100644
index 0000000..4185b7a
--- /dev/null
+++ b/tests/host/run_captured_hevc_driver.py
@@ -0,0 +1,159 @@
+#!/usr/bin/env python3
+# Copyright 2026 Q6A native video contributors.
+# SPDX-License-Identifier: MIT
+"""Replay externally authenticated fixed Q6A driver output through current source.
+
+The caller must authenticate the captured archive before passing its extracted
+stream and records. No fixture bytes, user paths, Android ABI values, compiler
+installation, network access or board operations are embedded in this test.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import stat
+import subprocess
+import sys
+import tempfile
+
+MAX_STREAM = 16 * 1024 * 1024
+MAX_RECORDS = 4 * 1024 * 1024
+
+
+def require(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+def fingerprint(info):
+    return tuple(getattr(info, field) for field in
+                 ("st_dev", "st_ino", "st_mode", "st_nlink", "st_size", "st_mtime_ns", "st_ctime_ns"))
+
+
+def regular(path, bound):
+    path = path.absolute()
+    require(path.resolve(strict=True) == path, "Fixture path must be canonical, without symlinks")
+    before = path.lstat()
+    require(stat.S_ISREG(before.st_mode) and before.st_nlink == 1 and 0 < before.st_size <= bound,
+            "Fixture must be one bounded regular file")
+    descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
+    with os.fdopen(descriptor, "rb") as stream:
+        require(fingerprint(os.fstat(stream.fileno())) == fingerprint(before),
+                "Fixture identity changed before reading")
+        raw = stream.read(bound + 1)
+        after = os.fstat(stream.fileno())
+    require(len(raw) == before.st_size and fingerprint(before) == fingerprint(after)
+            == fingerprint(path.lstat()), "Fixture changed while reading")
+    return raw
+
+
+def unique_object(pairs):
+    result = {}
+    for key, value in pairs:
+        require(key not in result, "Duplicate JSON record field")
+        result[key] = value
+    return result
+
+
+def invalid_constant(value):
+    raise ValueError("Non-finite JSON constant: " + value)
+
+
+def integer(row, field, maximum):
+    value = row.get(field)
+    require(type(value) is int and 0 <= value <= maximum, "Invalid integer record field: " + field)
+    return value
+
+
+def packet_ledger(records, stream):
+    lines = records.splitlines()
+    require(0 < len(lines) <= 512, "Unexpected record count")
+    rows = [json.loads(line, object_pairs_hook=unique_object, parse_constant=invalid_constant)
+            for line in lines]
+    require(all(isinstance(row, dict) for row in rows), "Record is not a JSON object")
+    headers = [row for row in rows if row.get("kind") == "header"]
+    summaries = [row for row in rows if row.get("kind") == "summary"]
+    packets = [row for row in rows if row.get("kind") == "coded_packet"]
+    require(len(headers) == len(summaries) == 1 and len(packets) == 33,
+            "Expected one fixed-trial header/summary and 33 CAPTURE callbacks")
+    expected = {"width": 3840, "height": 2160, "frames": 32, "fps": 30,
+                "expected_level_idc": 153}
+    require(all(type(headers[0].get(key)) is int and headers[0][key] == value
+                for key, value in expected.items()), "Captured configuration differs from the fixed trial")
+    expected_summary = {"queued_inputs": 32, "returned_inputs": 32, "capture_packets": 33,
+                        "last_seen": 1, "stop_sent": 1, "capture_streamoff": 1,
+                        "output_streamoff": 1, "maps_unmapped": 1, "device_closed": 1,
+                        "success": 1, "stream_bytes": len(stream)}
+    require(all(type(summaries[0].get(key)) is int and summaries[0][key] == value
+                for key, value in expected_summary.items()), "Captured queue/drain summary differs")
+    ledger = []
+    offset = 0
+    empty_last = 0
+    for index, row in enumerate(packets):
+        declared = integer(row, "stream_offset", MAX_STREAM)
+        count = integer(row, "stream_bytes", MAX_STREAM)
+        used = integer(row, "bytesused", MAX_STREAM)
+        data_offset = integer(row, "data_offset", MAX_STREAM)
+        flags = integer(row, "flags", 2**32-1)
+        integer(row, "index", 15)
+        seconds = integer(row, "timestamp_sec", 10)
+        micros = integer(row, "timestamp_usec", 999999)
+        require(declared == offset and data_offset <= used and used - data_offset == count
+                and count <= len(stream) - offset and not flags & 0x40,
+                "CAPTURE payload bounds/flags/byte ledger differ")
+        if count == 0:
+            require(index == len(packets)-1 and flags & 0x00100000,
+                    "Only the final empty LAST callback may omit coded bytes")
+            empty_last += 1
+        else:
+            require(not flags & 0x00100000, "Fixed fixture expects a separate empty LAST callback")
+        ledger.append(f"{offset} {count} {flags} {seconds * 1000000 + micros}\n")
+        offset += count
+    require(offset == len(stream) and empty_last == 1, "Incomplete stream ledger or missing empty LAST")
+    return "".join(ledger)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--stream", type=Path, required=True)
+    parser.add_argument("--records", type=Path, required=True)
+    parser.add_argument("--cxx", default=os.environ.get("CXX", "c++"))
+    args = parser.parse_args()
+    stream = regular(args.stream, MAX_STREAM)
+    records = regular(args.records, MAX_RECORDS)
+    ledger = packet_ledger(records, stream)
+    host = Path(__file__).resolve().parent
+    root = host.parents[1]
+    implementation = root / "common/HEVCEncoderHeaders.cpp"
+    header = root / "common/include/v4l2_codec2/common/HEVCEncoderHeaders.h"
+    compiler = shutil.which(args.cxx)
+    require(compiler is not None, "Host C++ compiler is unavailable")
+    with tempfile.TemporaryDirectory(prefix="q6a-captured-hevc-", dir=host) as directory:
+        work = Path(directory)
+        (work / "stream.hevc").write_bytes(stream)
+        (work / "packets.txt").write_text(ledger)
+        command = [compiler, "-std=c++17", "-O2", "-Wall", "-Wextra", "-Werror", "-UNDEBUG",
+                   "-fsanitize=address,undefined", "-fno-omit-frame-pointer",
+                   "-I" + str(root / "common/include"), str(implementation),
+                   str(host / "CapturedHEVCDriver_test.cpp"), "-o", str(work / "replay")]
+        subprocess.run(command, check=True, timeout=60)
+        subprocess.run([str(work / "replay"), str(work / "stream.hevc"), str(work / "packets.txt")],
+                       check=True, timeout=30)
+    print("Captured stream SHA256: " + hashlib.sha256(stream).hexdigest())
+    print("Captured records SHA256: " + hashlib.sha256(records).hexdigest())
+    print("Current helper SHA256: " + hashlib.sha256(implementation.read_bytes()).hexdigest())
+    print("Current header SHA256: " + hashlib.sha256(header.read_bytes()).hexdigest())
+    print("Host source/packet logic only; Android compilation, candidate runtime and hardware are separate.")
+    return 0
+
+
+if __name__ == "__main__":
+    try:
+        raise SystemExit(main())
+    except (OSError, ValueError, subprocess.SubprocessError) as error:
+        print("Captured HEVC source check failed: " + str(error), file=sys.stderr)
+        raise SystemExit(1)
