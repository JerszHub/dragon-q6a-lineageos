+#!/usr/bin/env python3
+# SPDX-License-Identifier: BSD-3-Clause
+"""Run driver compatibility source checks using a retained capture fixture."""
+from pathlib import Path
+import argparse
+import subprocess
+import sys
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--stream', type=Path, required=True)
+    parser.add_argument('--records', type=Path, required=True)
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parents[2]
+    tests = Path(__file__).resolve().parent
+    scripts = [('run_q6a_iris_tier_gate.py', []),
+               ('run_hevc_geometry_rate.py', []),
+               ('run_captured_hevc_driver.py', ['--stream', str(args.stream), '--records', str(args.records)])]
