+#!/usr/bin/env python3
+# SPDX-License-Identifier: MIT
+"""Exercise the actual Q6A missing-tier gate and strict encoder tier path.
+
+Only the source bodies are extracted. Minimal property/sysfs/V4L2 fixtures run
+on the host; this is not an Android build, target-loader test or encode proof.
+"""
+from __future__ import annotations
+import argparse
+import hashlib
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+
+
+def function(source, signature):
+    start = source.index(signature)
+    brace = source.index("{", start)
+    depth = 0
+    for position in range(brace, len(source)):
+        if source[position] == "{":
+            depth += 1
+        elif source[position] == "}":
+            depth -= 1
+            if depth == 0:
+                return source[start:position + 1]
+    raise ValueError("Unclosed source function: " + signature)
+
+
+PREAMBLE = r'''
+#include <algorithm>
+#include <cassert>
+#include <cerrno>
+#include <climits>
+#include <cstdint>
+#include <cstring>
+#include <fcntl.h>
+#include <iostream>
+#include <linux/v4l2-controls.h>
+#include <linux/videodev2.h>
+#include <map>
+#include <memory>
+#include <optional>
+#include <sys/types.h>
+#include <unistd.h>
+#include <vector>
+#define ALOGE(...) ((void)0)
+#define HANDLE_EINTR(expression) (expression)
+struct Fixture {
+    bool optIn = true, profileMenu = true, levelMenu = true, tierMenu = false;
+    bool noteOpen = true, noteRead = true, forceSupported = true;
+    int queryCapRc = 0, queryTierRc = -1, queryTierErrno = EINVAL;
+    int getTierRc = -1, getTierErrno = EINVAL;
+    uint32_t tierFlags = 0, tierType = V4L2_CTRL_TYPE_MENU;
+    int tryRc = 0, setRc = 0, tierMenuRc = 0;
+    bool changeReadback = false;
+    int propertyCalls = 0, capCalls = 0, tierQueries = 0, tierGets = 0, tierSets = 0;
+    int openCalls = 0, readCalls = 0, closeCalls = 0;
+    v4l2_capability capability = {};
+    std::vector<uint8_t> note;
+    std::vector<uint32_t> tierValues = {V4L2_MPEG_VIDEO_HEVC_TIER_MAIN};
+    std::map<uint32_t, int32_t> values;
+} state;
+// Independent bytes from the authenticated successful driver trial's loaded
+// GNU build-id note, not copied by parsing the source constant under test.
+static const uint8_t reviewedNote[] = {
+    4,0,0,0,20,0,0,0,3,0,0,0,'G','N','U',0,
+    0x99,0x2a,0x2f,0x2c,0x04,0xc9,0x51,0x98,0xeb,0xe7,
+    0xab,0x33,0xc5,0x4d,0x54,0x7b,0xa3,0xb3,0x47,0xa5
+};
+void reset() {
+    state = Fixture();
+    std::strcpy(reinterpret_cast<char*>(state.capability.driver), "iris_driver");
+    std::strcpy(reinterpret_cast<char*>(state.capability.card), "Iris Encoder");
+    std::strcpy(reinterpret_cast<char*>(state.capability.bus_info), "plat:aa00000.video-codec:enc");
+    state.capability.version = 459264;
+    state.capability.capabilities = 2216706048U;
+    state.capability.device_caps = 69222400U;
+    state.note.assign(std::begin(reviewedNote), std::end(reviewedNote));
+}
+bool property_get_bool(const char* name, bool fallback) {
+    assert(std::strcmp(name, "ro.vendor.v4l2_codec2.hevc.iris_main_tier") == 0);
+    assert(!fallback); ++state.propertyCalls; return state.optIn;
+}
+int fixtureOpen(const char* path, int flags) {
+    assert(std::strcmp(path, "/sys/module/qcom_iris/notes/.note.gnu.build-id") == 0);
+    assert(flags == (O_RDONLY | O_CLOEXEC | O_NOFOLLOW)); ++state.openCalls;
+    if (!state.noteOpen) { errno = EACCES; return -1; } return 5;
+}
+ssize_t fixtureRead(int fd, void* output, size_t count) {
+    assert(fd == 5 && count == 37); ++state.readCalls;
+    if (!state.noteRead) { errno = EIO; return -1; }
+    size_t size = std::min(count, state.note.size());
+    std::memcpy(output, state.note.data(), size); return static_cast<ssize_t>(size);
+}
+namespace base {
+class ScopedFD {
+public:
+    explicit ScopedFD(int fd) : fd_(fd) {}
+    ~ScopedFD() { if (fd_ >= 0) ++state.closeCalls; }
+    bool is_valid() const { return fd_ >= 0; }
+    int get() const { return fd_; }
+private: int fd_;
+};
+}
+struct C2Config { enum profile_t { PROFILE_HEVC_MAIN=77, PROFILE_OTHER=78 }; using level_t=int; };
+struct HEVCConfig { C2Config::level_t level; uint32_t framerate; };
+class V4L2Device {
+public:
+    bool allowsQ6AIrisMissingHEVCTierControl();
+    static std::optional<int32_t> c2HEVCLevelToV4L2(int level) {
+        return level >= 0 && level <= 12 ? std::optional<int32_t>(level) : std::nullopt;
+    }
+    int ioctl(int signedRequest, void* arg) {
+        uint32_t request = static_cast<uint32_t>(signedRequest);
+        if (request == static_cast<uint32_t>(VIDIOC_QUERYCAP)) {
+            ++state.capCalls; *static_cast<v4l2_capability*>(arg) = state.capability;
+            return state.queryCapRc;
+        }
+        if (request == static_cast<uint32_t>(VIDIOC_QUERYCTRL)) {
+            auto* query = static_cast<v4l2_queryctrl*>(arg);
+            if (query->id == V4L2_CID_MPEG_VIDEO_HEVC_TIER) {
+                ++state.tierQueries;
+                if (state.queryTierRc) { errno = state.queryTierErrno; return state.queryTierRc; }
+                query->type = state.tierType; query->flags = state.tierFlags;
+                query->minimum = 0; query->maximum = 1; query->step = 1; return 0;
+            }
+            if (query->id == V4L2_CID_MPEG_VIDEO_FORCE_KEY_FRAME) {
+                if (!state.forceSupported) { errno = EINVAL; return -1; }
+                query->type = V4L2_CTRL_TYPE_BUTTON; return 0;
+            }
+            query->minimum = 0; query->maximum = INT32_MAX; query->step = 1;
+            query->type = (query->id == V4L2_CID_MPEG_VIDEO_HEVC_PROFILE ||
+                           query->id == V4L2_CID_MPEG_VIDEO_HEVC_LEVEL)
+                                  ? V4L2_CTRL_TYPE_MENU : V4L2_CTRL_TYPE_INTEGER;
+            return 0;
+        }
+        if (request == static_cast<uint32_t>(VIDIOC_QUERYMENU)) {
+            auto* menu = static_cast<v4l2_querymenu*>(arg);
+            return menu->id == V4L2_CID_MPEG_VIDEO_HEVC_TIER ? state.tierMenuRc : 0;
+        }
+        if (request == static_cast<uint32_t>(VIDIOC_TRY_EXT_CTRLS)) return state.tryRc;
+        if (request == static_cast<uint32_t>(VIDIOC_S_EXT_CTRLS)) {
+            auto* controls = static_cast<v4l2_ext_controls*>(arg);
+            assert(controls->count == 1);
+            const auto& control = controls->controls[0];
+            if (control.id == V4L2_CID_MPEG_VIDEO_HEVC_TIER) ++state.tierSets;
+            state.values[control.id] = control.value; return state.setRc;
+        }
+        assert(request == static_cast<uint32_t>(VIDIOC_G_CTRL));
+        auto* control = static_cast<v4l2_control*>(arg);
+        if (control->id == V4L2_CID_MPEG_VIDEO_HEVC_TIER) {
+            ++state.tierGets;
+            if (state.getTierRc) { errno = state.getTierErrno; return state.getTierRc; }
+        }
+        control->value = state.values[control->id] + (state.changeReadback ? 1 : 0); return 0;
+    }
+};
+class V4L2Encoder {
+public:
+    std::shared_ptr<V4L2Device> mDevice = std::make_shared<V4L2Device>();
+    uint32_t mKeyFramePeriod=30;
+    bool mForceKeyFrameSupported=false, mInjectParamsBeforeIDR=true;
+    bool configureHEVC(C2Config::profile_t profile, std::optional<HEVCConfig> config);
+    bool setFramerate(uint32_t value) { return value == 30; }
+};
+struct ProbeCaps { bool accepted = false; size_t tierMenuEntries = 0; };
+'''
+
+
+TESTS = r'''
+extern "C" const char* __asan_default_options() { return "detect_leaks=0"; }
+int main() {
+    V4L2Device device;
+    reset(); state.optIn=false; assert(!device.allowsQ6AIrisMissingHEVCTierControl());
+    assert(state.propertyCalls==1 && state.capCalls==0 && state.openCalls==0);
+    reset(); assert(device.allowsQ6AIrisMissingHEVCTierControl());
+    assert(state.capCalls==1 && state.openCalls==1 && state.readCalls==1 &&
+           state.closeCalls==1 && state.tierQueries==1 && state.tierGets==1 && state.tierSets==0);
+    for (int field=0; field<7; ++field) {
+        reset();
+        switch(field) {
+        case 0: state.queryCapRc=-1; break;
+        case 1: state.capability.driver[0]='X'; break;
+        case 2: std::strcpy(reinterpret_cast<char*>(state.capability.card),"Iris Decoder"); break;
+        case 3: state.capability.bus_info[0]='X'; break;
+        case 4: ++state.capability.version; break;
+        case 5: state.capability.capabilities^=1; break;
+        case 6: state.capability.device_caps^=1; break;
+        }
+        assert(!device.allowsQ6AIrisMissingHEVCTierControl());
+        assert(state.openCalls==0 && state.tierQueries==0 && state.tierGets==0);
+    }
+    for (int failure=0; failure<5; ++failure) {
+        reset();
+        if(failure==0)state.noteOpen=false;
+        if(failure==1)state.noteRead=false;
+        if(failure==2)state.note[17]^=1;
+        if(failure==3)state.note.pop_back();
+        if(failure==4)state.note.push_back(0);
+        assert(!device.allowsQ6AIrisMissingHEVCTierControl());
+        assert(state.tierQueries==0 && state.tierGets==0);
+        assert(state.closeCalls==(failure==0?0:1));
+    }
+    reset(); state.queryTierRc=0;
+    assert(!device.allowsQ6AIrisMissingHEVCTierControl() && state.tierGets==0);
+    reset(); state.queryTierRc=1;
+    assert(!device.allowsQ6AIrisMissingHEVCTierControl() && state.tierGets==0);
+    reset(); state.queryTierErrno=EIO;
+    assert(!device.allowsQ6AIrisMissingHEVCTierControl() && state.tierGets==0);
+    reset(); state.getTierRc=0; assert(!device.allowsQ6AIrisMissingHEVCTierControl());
+    reset(); state.getTierRc=1; assert(!device.allowsQ6AIrisMissingHEVCTierControl());
+    reset(); state.getTierErrno=EIO; assert(!device.allowsQ6AIrisMissingHEVCTierControl());
+
+    // Actual capability predicate never invents a tier menu entry. An absent
+    // tier can pass only the complete reviewed gate; present invalid menus
+    // cannot be relabeled as missing.
+    reset(); const auto absentCaps=capabilityProbe();
+    assert(absentCaps.accepted && absentCaps.tierMenuEntries==0);
+    reset(); state.optIn=false; assert(!capabilityProbe().accepted);
+    reset(); state.getTierRc=0; assert(!capabilityProbe().accepted);
+    reset(); state.queryTierRc=0; assert(!capabilityProbe().accepted);
+    reset(); state.queryTierRc=0; state.tierFlags=V4L2_CTRL_FLAG_DISABLED;
+    assert(!capabilityProbe().accepted);
+    reset(); state.queryTierRc=0; state.tierType=V4L2_CTRL_TYPE_INTEGER;
+    assert(!capabilityProbe().accepted);
+    reset(); state.tierMenu=true; state.optIn=false;
+    const auto presentCaps=capabilityProbe();
+    assert(presentCaps.accepted && presentCaps.tierMenuEntries==1);
+    assert(state.propertyCalls==0 && state.openCalls==0);
+    reset(); state.tierMenu=true; state.tierValues={V4L2_MPEG_VIDEO_HEVC_TIER_HIGH};
+    assert(!capabilityProbe().accepted);
+    reset(); state.profileMenu=false; assert(!capabilityProbe().accepted);
+    reset(); state.levelMenu=false; assert(!capabilityProbe().accepted);
+
+    const HEVCConfig config{8,30};
+    reset(); V4L2Encoder absent;
+    assert(absent.configureHEVC(C2Config::PROFILE_HEVC_MAIN,config));
+    assert(state.tierSets==0 && absent.mForceKeyFrameSupported && !absent.mInjectParamsBeforeIDR);
+    reset(); state.optIn=false; V4L2Encoder closed;
+    assert(!closed.configureHEVC(C2Config::PROFILE_HEVC_MAIN,config) && state.tierSets==0);
+    // With a present tier, preserve strict TRY/S/G control behavior even when
+    // the opt-in is enabled. Disabled, invalid and menu-hole controls fail.
+    reset(); state.queryTierRc=state.getTierRc=0; V4L2Encoder strict;
