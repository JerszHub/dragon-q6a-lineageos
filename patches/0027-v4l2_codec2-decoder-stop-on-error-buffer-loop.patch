diff --git a/v4l2/include/v4l2_codec2/v4l2/V4L2Decoder.h b/v4l2/include/v4l2_codec2/v4l2/V4L2Decoder.h
--- a/v4l2/include/v4l2_codec2/v4l2/V4L2Decoder.h
+++ b/v4l2/include/v4l2_codec2/v4l2/V4L2Decoder.h
@@ -143,6 +143,10 @@
     ErrorCB mErrorCb;
     // Number of frames dropped since the last frame sent to the client, for logging.
     size_t mNumDroppedFrames = 0;
+    // Output buffers the device has returned empty and flagged as errors in a row, without a
+    // decoded frame in between. A driver whose session has failed bounces every buffer queued
