diff --git a/device.mk b/device.mk
index f65bfc7..7edf467 100644
--- a/device.mk
+++ b/device.mk
@@ -20,6 +20,9 @@ TARGET_SCREEN_HEIGHT := 300
 # Camera
 TARGET_EXTERNAL_CAMERA_PROVIDER_HAL := default-aidl
 
+# Video codecs: the V4L2 stateful Codec2 HAL, on top of the Venus driver
+TARGET_MEDIA_C2_HAL := v4l2_codec2
+
 # Dalvik heap
 $(call inherit-product, frameworks/native/build/tablet-10in-xhdpi-2048-dalvik-heap.mk)
 
@@ -41,7 +44,11 @@ PRODUCT_PACKAGES += \
 
 # Graphics (Mesa)
 TARGET_MESA_DO_NOT_SET_AS_DEFAULT := true
-TARGET_MESA_ENABLE_SOFTWARE_RENDERER := true
+# Q6A: WYLACZONE. W mesie 26.2.3 lavapipe (swrast) ma 241 MB niestrippowanych,
+# and copying it to LINKED/ produces a zero-length file -> llvm-strip "not a valid object file".
+# We do not need it: Turnip (vulkan.freedreno) builds fine, and the software Vulkan
+# fallback lives in org.lineageos.device.graphics.vulkan.swiftshader.apex.
+TARGET_MESA_ENABLE_SOFTWARE_RENDERER := false
 
 # Graphics allocator
 PRODUCT_PACKAGES += \
@@ -184,9 +191,45 @@ PRODUCT_SOONG_NAMESPACES += \
     $(DEVICE_PATH) \
     kernel/mainline/configs
 
+# Q6A 2026-09-21: firmware AIC8800D80 (WiFi + Bluetooth).
+# The driver reads files DIRECTLY through filp_open (CONFIG_USE_FW_REQUEST=n),
+# not through request_firmware, so firmware_class.path does NOT apply to it.
+# With CONFIG_PLATFORM_UBUNTU=n the path is FLAT: aic_default_fw_path + "/" + name,
+# with no per-chip-variant subdirectory (aicbluetooth.c:333, the #else branch).
+# aic_default_fw_path = "/vendor/etc/firmware" (aicbluetooth.c:149).
+PRODUCT_COPY_FILES += $(foreach f,$(wildcard device/radxa/dragon_q6a/firmware/aic8800/*), \
+    $(f):$(TARGET_COPY_OUT_VENDOR)/etc/firmware/$(notdir $(f)))
+
+# adb over TCP on Ethernet. The board has no USB device mode, so this is the only adb
+# channel during development. Release builds must not listen for adb on the network.
+ifeq ($(Q6A_DEBUG_NET),true)
+PRODUCT_PACKAGES += \
+    q6a_debug_net.rc \
+    q6a_debug_net.sh
+endif
+
+# Q6A: jawne ladowanie sterownikow WiFi/BT - aliasy w vendor_dlkm/modules.alias
+# do not cover our prebuilts, and nothing on this device reads modules.load.
+PRODUCT_PACKAGES += \
+    q6a_load_wifi_bt.rc \
+    q6a_load_wifi_bt.sh \
+    q6a_expand_userdata.rc \
+    q6a_expand_userdata.sh \
+    q6a_install_gapps.rc \
+    q6a_install_gapps.sh \
+    q6a_tuning.rc \
+    q6a_perf.sh
+
 # USB
+# Q6A: ship the gadget stub ONLY when no real HAL has been selected.
+# options.mk defaults TARGET_USB_GADGET_HAL to mainline, which pulls in
+# com.android.hardware.usb.gadget.mainline; wyslanie obu wklada do /vendor/apex
+# dwa pakiety deklarujace ten sam modul "com.android.hardware.usb.gadget".
+# apexd then aborts, and apexd-bootstrap has reboot_on_failure -> a boot loop.
+ifneq ($(TARGET_USB_GADGET_HAL),mainline)
 PRODUCT_PACKAGES += \
     com.android.hardware.usb.gadget.none
+endif
 
 # Utilities
 PRODUCT_PACKAGES += \
