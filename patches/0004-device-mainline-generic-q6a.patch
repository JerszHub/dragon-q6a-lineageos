diff --git a/configs/init/init.generic.rc b/configs/init/init.generic.rc
index 94971a3..a0757af 100644
--- a/configs/init/init.generic.rc
+++ b/configs/init/init.generic.rc
@@ -73,6 +73,12 @@ service vendor.light-default /vendor/bin/hw/android.hardware.light-service.linea
     shutdown critical
     override
 
+# Memory
+# Games such as Genshin Impact use more than the default 65530 mappings per process
+# and crash once they hit the limit. Desktop Linux distributions use the same value.
+on early-init
+    write /proc/sys/vm/max_map_count 1048576
+
 # Kernel modules
 on early-init
     exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -d /vendor/lib/modules zram.ko
diff --git a/configs/properties/vendor.prop b/configs/properties/vendor.prop
index d301860..a8a5bf6 100644
--- a/configs/properties/vendor.prop
+++ b/configs/properties/vendor.prop
@@ -29,3 +29,46 @@ ro.boot.wifi_mac_prefix=5554
 
 # ZRAM
 persist.sys.zram_enabled=1
+
+
+# Genshin Impact, and anything else that keys its rendering path off GL_RENDERER
+#
+# Mesa named this chip through the a635 wildcard entry until commit b1e851d66c3
+# ("freedreno: Add Adreno 643", 2023-09-26), which gave chip_id 0x00ac06030500 its own entry
+# called "FD643". Genshin recognises the old name and not the new one, and on the new one it
+# silently drops to a path that renders no water and no rocks, shades with the wrong shadow
+# cascades and corrupts world textures, while the 2D interface stays perfect. The driver is
+# correct throughout; only the string the application matches on changed. Confirmed on
+# hardware: restoring the old name fixes it completely.
+#
+# This affects every QCM6490/QCS6490 device on a Mesa that carries that commit, Fairphone 5
+# among them. The proper fix belongs in Mesa's per-application workarounds in
+# 00-mesa-defaults.conf, which already carries two entries of exactly this kind.
+mesa.force.gl.renderer=Adreno 7c+ Gen 3
+
+# Mesa's on-disk shader cache is deliberately NOT enabled here.
+# Mesa turns it off on Android because the EGL layer manages one through
+# EGL_ANDROID_blob_cache, and that is the path this device's GLES clients take. Pointing
+# mesa.shader.cache.dir at a shared directory was tried on 2026-09-28 and made things worse:
+# the cache stayed empty and the first client to touch the directory created it 0700, which
+# locked every other client out of caching at all.
+
+# Use the multifile EGL blob cache instead of the default monolithic one.
+# The monolithic cache holds at most 2 MiB in total and 64 KiB per entry. Mesa caches every
+# compiled shader variant through it, and a single Genshin Impact session writes about
+# 1,700 entries and 9 MB, so the monolithic file is always full and keeps evicting what the
+# next session needs. Every entry it loses is a shader the driver recompiles at draw time,
+# which showed up as frames of 100 ms to over 3 s.
+# Measured on hardware (2026-10-06): with a cache that survives between sessions, the time the
+# rendering thread spent waiting for shader compiles dropped from about 7.7 s to 0.4 s per
+# session, and no stall above 300 ms remained.
+# This needs the fix to MultifileBlobCache::get() carried in frameworks/native: without it,
+# every lookup with a buffer larger than the cached value, which is what Mesa always does,
+# is treated as a miss.
+ro.egl.blobcache.multifile=true
+# Genshin Impact's shader warm-up alone writes about 70,000 entries and 550 MiB, so the default
+# caps (32 MiB, 4096 entries) would evict most of it. On overflow the cache drops half its
+# content, so keep the caps well above that. These are ceilings, not reservations.
+# The byte limit is parsed as uint32_t: 4294967295 is the largest value that is not ignored.
+ro.egl.blobcache.multifile_limit=4294967295
+ro.egl.blobcache.multifile_entry_limit=262144
