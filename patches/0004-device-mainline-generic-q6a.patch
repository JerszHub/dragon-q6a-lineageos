diff --git a/Generic_arm64/BoardConfig.mk b/Generic_arm64/BoardConfig.mk
index 14e92ba..701ba9e 100644
--- a/Generic_arm64/BoardConfig.mk
+++ b/Generic_arm64/BoardConfig.mk
@@ -50,3 +50,46 @@ TARGET_KERNEL_CONFIG_EXT := \
     kernel/mainline/configs/fragments/y/fbcon.config \
     $(DEVICE_PATH)/configs/kernel/customizations.config
 endif
+
+# Q6A 2026-09-20: a WHITELIST instead of a blacklist. The board has an Adreno 643, so the
+# potrzebny sterownik to freedreno (gallium + Turnip w Vulkanie). Drzewo urzadzenia
+# wlacza komplet sterownikow ARM i desktopowych, a kazdy dokladany po jednym do
+# filtra kosztowal nas osobny nieudany build:
+#
+#   asahi, imagination  -> no MESA_VK_LIB_SUFFIX_* mapping in external/mesa
+#                          (Android.mk knows only 8 names) -> two modules both named "vulkan."
+#                          -> base_rules.mk:320 "already defined"
+#                          Na Gerricie leza DWIE PORZUCONE zmiany dokladajace ta strone.
+#   radeonsi, amd       -> podnosza wymaganie libdrm do 2.4.133 "for AMDGPU"
+#                          (mesa e0b5724e85d), a external/libdrm ma 2.4.124
+#                          -> meson.build:1921 "Invalid version"
+#   etnaviv             -> needs the Python module pycparser >= 2.20, which is not present
+#                          ani w systemie, ani w prebuilts/mesa-build-dep
+#                          -> src/etnaviv/hwdb/meson.build:15
+#
+# So rather than adding more filter-out lines, both lists are cut down to freedreno.
+# MIND THE PLACEMENT: this file includes its parent at line 7 and appends afterwards,
+# so the filter in device/mainline/generic/BoardConfig.mk (the nouveau one) runs
+# TOO EARLY. It has to live at the end of THIS file.
+BOARD_MESA3D_GALLIUM_DRIVERS := freedreno
+BOARD_MESA3D_VULKAN_DRIVERS := freedreno
+
+# Q6A 2026-09-21: WiFi i Bluetooth — AIC8800D80 na USB (a69c:8d80, po firmware 8d81).
+# Modules built FROM SOURCE (radxa-pkg/aic8800) against our kernel; see build_aic8800.sh.
+# The v7 modules were RadxaOS prebuilts (vermagic 6.18.2-4-qcom) and will NOT load here.
+#
+# ⚠️ PLACEMENT: device/mainline/generic/BoardConfig.mk sets BOARD_VENDOR_KERNEL_MODULES_LOAD
+# with ":=" at line 82, and our kernel/board.mk is included EARLIER (line 74), so an entry
+# there would be overwritten. This file includes the parent at line 7, so it runs after it.
+#
+# ⚠️ ORDER MATTERS: aic_load_fw uploads the firmware and the chip re-enumerates
+# (8d80 -> 8d81), dopiero potem aic8800_fdrv moze go obsluzyc.
+DRAGON_Q6A_MODULES := device/radxa/dragon_q6a/kernel/modules
+BOARD_VENDOR_KERNEL_MODULES += \
+    $(DRAGON_Q6A_MODULES)/aic_load_fw.ko \
+    $(DRAGON_Q6A_MODULES)/aic8800_fdrv.ko \
+    $(DRAGON_Q6A_MODULES)/aic_btusb.ko
+BOARD_VENDOR_KERNEL_MODULES_LOAD += \
+    aic_load_fw.ko \
+    aic8800_fdrv.ko \
+    aic_btusb.ko
