diff --git a/device.mk b/device.mk
index f65bfc7..44717d7 100644
--- a/device.mk
+++ b/device.mk
@@ -41,7 +41,11 @@ PRODUCT_PACKAGES += \
 
 # Graphics (Mesa)
 TARGET_MESA_DO_NOT_SET_AS_DEFAULT := true
-TARGET_MESA_ENABLE_SOFTWARE_RENDERER := true
+# Q6A: WYLACZONE. W mesie 26.2.3 lavapipe (swrast) ma 241 MB niestrippowanych,
+# a kopiowanie do LINKED/ daje plik zerowy -> llvm-strip "not a valid object file".
+# Nie potrzebujemy go: Turnip (vulkan.freedreno) buduje sie poprawnie, a programowy
+# fallback Vulkana jest w org.lineageos.device.graphics.vulkan.swiftshader.apex.
+TARGET_MESA_ENABLE_SOFTWARE_RENDERER := false
 
 # Graphics allocator
 PRODUCT_PACKAGES += \
@@ -184,9 +188,36 @@ PRODUCT_SOONG_NAMESPACES += \
     $(DEVICE_PATH) \
     kernel/mainline/configs
 
+# Q6A 2026-09-21: firmware AIC8800D80 (WiFi + Bluetooth).
+# Sterownik czyta pliki BEZPOSREDNIO przez filp_open (CONFIG_USE_FW_REQUEST=n),
+# nie przez request_firmware - wiec firmware_class.path go NIE dotyczy.
+# Przy CONFIG_PLATFORM_UBUNTU=n sciezka jest PLASKA: aic_default_fw_path + "/" + nazwa,
+# bez podkatalogu na wariant ukladu (aicbluetooth.c:333, galaz #else).
+# aic_default_fw_path = "/vendor/etc/firmware" (aicbluetooth.c:149).
+PRODUCT_COPY_FILES += $(foreach f,$(wildcard device/radxa/dragon_q6a/firmware/aic8800/*), \
+    $(f):$(TARGET_COPY_OUT_VENDOR)/etc/firmware/$(notdir $(f)))
+
+# LOCAL DEBUG AID for Radxa Dragon Q6A bring up, remove once the display works.
+PRODUCT_PACKAGES += \
+    q6a_debug_net.rc \
+    q6a_debug_net.sh
+
+# Q6A: jawne ladowanie sterownikow WiFi/BT - aliasy w vendor_dlkm/modules.alias
+# nie obejmuja naszych prebuiltow, a modules.load nikt na tym urzadzeniu nie czyta.
+PRODUCT_PACKAGES += \
+    q6a_load_wifi_bt.rc \
+    q6a_load_wifi_bt.sh
+
 # USB
+# Q6A: zaslepke gadzetu wysylamy TYLKO gdy nie wybrano prawdziwego HAL-a.
+# options.mk domyslnie ustawia TARGET_USB_GADGET_HAL=mainline, co wciaga
+# com.android.hardware.usb.gadget.mainline; wyslanie obu wklada do /vendor/apex
+# dwa pakiety deklarujace ten sam modul "com.android.hardware.usb.gadget".
+# apexd sie wtedy wywala, a apexd-bootstrap ma reboot_on_failure -> petla bootu.
+ifneq ($(TARGET_USB_GADGET_HAL),mainline)
 PRODUCT_PACKAGES += \
     com.android.hardware.usb.gadget.none
+endif
 
 # Utilities
 PRODUCT_PACKAGES += \
