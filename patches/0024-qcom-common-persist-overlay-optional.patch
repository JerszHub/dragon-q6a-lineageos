diff --git a/optional/README.md b/optional/README.md
index 152db4b..bb745b3 100644
--- a/optional/README.md
+++ b/optional/README.md
@@ -5,6 +5,14 @@
 |-------|-----------|-------------|
 | qcom-caf-aidl | boot-hal_qcom-caf-aidl | Downstream boot control HAL from hardware/qcom-caf/bootctrl |
 
+## Persist
+
+### TARGET_QCOM_USES_PERSIST_OVERLAY
+| Value | Description |
+|-------|-------------|
+| true | Mount a tmpfs-backed overlay over `/mnt/vendor/persist`, so that nothing on the device writes to the persist partition. Default. |
+| false | Leave `/mnt/vendor/persist` writable. Default when `TARGET_BOOT_HAL` is `grub`, whose A/B slot state lives there. |
+
 ## USB
 
 ### TARGET_USB_HAL
diff --git a/optional/options.mk b/optional/options.mk
index 85cdab0..c414d02 100644
--- a/optional/options.mk
+++ b/optional/options.mk
@@ -48,6 +48,13 @@ endif
 # Graphics HALs
 TARGET_GRAPHICS_ALLOCATOR_HAL ?= minigbm-upstream
 
+# Persist
+# GRUB keeps its A/B slot state in /mnt/vendor/persist, which the overlay would make volatile.
+ifeq ($(TARGET_BOOT_HAL),grub)
+TARGET_QCOM_USES_PERSIST_OVERLAY ?= false
+endif
+TARGET_QCOM_USES_PERSIST_OVERLAY ?= true
+
 # Inherit from mainline/common
 include device/mainline/common/optional/options.mk
 
