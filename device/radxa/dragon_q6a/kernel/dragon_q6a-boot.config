# Drivers first stage init needs to mount the boot disk, built in rather than loaded from
# the vendor ramdisk: NVMe behind the QMP PCIe PHY and its RPMh regulators, the SD card
# controller, vfat for the firmware partition, and efivarfs for the boot loader's variables.
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_EFIVAR_FS=y
