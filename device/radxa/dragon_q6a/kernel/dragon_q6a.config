#
# Radxa Dragon Q6A (QCS6490), on top of gki_defconfig and kernel/mainline/configs' common
# fragments.
#
# The Qualcomm part is what the board's device tree needs, with the values of the configuration
# the board ships with: the drivers on first stage init's path (clocks, pinctrl, interconnect,
# RPMh, SMMU, SCM) built in, the rest as modules. GKI turns the parents of these menus off,
# so they are listed as well.

# Qualcomm SoC (from the configuration the board ships with)
CONFIG_ARM_QCOM_CPUFREQ_HW=m
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_DISABLE_BYPASS_BY_DEFAULT=y
CONFIG_ARM_SMMU_QCOM=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_DRM_MSM=m
CONFIG_DRM_MSM_DP=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_DRM_MSM_GPU_STATE=y
CONFIG_DRM_MSM_KMS=y
CONFIG_DRM_MSM_KMS_FBDEV=y
CONFIG_DRM_MSM_MDSS=y
CONFIG_EXTCON_QCOM_SPMI_MISC=m
CONFIG_HWSPINLOCK_QCOM=m
CONFIG_I2C_QCOM_CCI=m
CONFIG_I2C_QCOM_GENI=m
CONFIG_INTERCONNECT_CLK=y
CONFIG_INTERCONNECT_QCOM_BCM_VOTER=y
CONFIG_INTERCONNECT_QCOM_OSM_L3=m
CONFIG_INTERCONNECT_QCOM_RPMH=y
CONFIG_INTERCONNECT_QCOM_RPMH_POSSIBLE=y
CONFIG_INTERCONNECT_QCOM_SC7280=y
CONFIG_LEDS_QCOM_LPG=m
CONFIG_MFD_SPMI_PMIC=m
CONFIG_NVMEM_QCOM_QFPROM=m
CONFIG_NVMEM_SPMI_SDAM=m
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_COMBO=m
CONFIG_PHY_QCOM_QMP_UFS=m
CONFIG_PHY_QCOM_QMP_USB=m
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=m
CONFIG_PINCTRL_LPASS_LPI=m
CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_PINCTRL_SC7280=y
CONFIG_PINCTRL_SC7280_LPASS_LPI=m
CONFIG_POWER_RESET_QCOM_PON=m
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_APR=m
CONFIG_QCOM_BAM_DMA=m
CONFIG_QCOM_CLK_RPMH=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_FASTRPC=m
CONFIG_QCOM_GPI_DMA=m
CONFIG_QCOM_ICC_BWMON=m
CONFIG_QCOM_IPCC=m
CONFIG_QCOM_LLCC=m
CONFIG_QCOM_LMH=m
CONFIG_QCOM_MDT_LOADER=m
CONFIG_QCOM_PAS=y
CONFIG_QCOM_PDC=y
CONFIG_QCOM_PDR_MSG=m
CONFIG_QCOM_PD_MAPPER=m
CONFIG_QCOM_PIL_INFO=m
CONFIG_QCOM_Q6V5_COMMON=m
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_QMI_HELPERS=m
CONFIG_QCOM_QSEECOM=y
CONFIG_QCOM_QSEECOM_UEFISECAPP=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_RPROC_COMMON=m
CONFIG_QCOM_SCM=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMP2P=m
CONFIG_QCOM_SOCINFO=m
CONFIG_QCOM_SPMI_ADC5=m
CONFIG_QCOM_SPMI_ADC_TM5=m
CONFIG_QCOM_SPMI_TEMP_ALARM=m
CONFIG_QCOM_STATS=m
CONFIG_QCOM_SYSMON=m
CONFIG_QCOM_TSENS=m
CONFIG_QCOM_TZMEM=y
CONFIG_QCOM_TZMEM_MODE_GENERIC=y
CONFIG_QCOM_UBWC_CONFIG=m
CONFIG_QCOM_VADC_COMMON=m
CONFIG_QCOM_WDT=m
CONFIG_QRTR=m
CONFIG_QRTR_SMD=m
CONFIG_REGMAP_SOUNDWIRE=m
CONFIG_REGULATOR_QCOM_REFGEN=m
CONFIG_RESET_QCOM_AOSS=y
CONFIG_RESET_QCOM_PDC=m
CONFIG_RPMSG_QCOM_GLINK=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_SCSI_UFS_QCOM=m
CONFIG_SC_CAMCC_7280=m
CONFIG_SC_DISPCC_7280=m
CONFIG_SC_GCC_7280=y
CONFIG_SC_GPUCC_7280=m
CONFIG_SC_LPASSCC_7280=m
CONFIG_SC_LPASS_CORECC_7280=m
CONFIG_SC_VIDEOCC_7280=m
CONFIG_SND_SOC_LPASS_MACRO_COMMON=m
CONFIG_SND_SOC_LPASS_RX_MACRO=m
CONFIG_SND_SOC_LPASS_TX_MACRO=m
CONFIG_SND_SOC_LPASS_VA_MACRO=m
CONFIG_SND_SOC_LPASS_WSA_MACRO=m
CONFIG_SND_SOC_QCOM=m
CONFIG_SND_SOC_QCOM_COMMON=m
CONFIG_SND_SOC_QCOM_SDW=m
CONFIG_SND_SOC_QDSP6=m
CONFIG_SND_SOC_QDSP6_APM=m
CONFIG_SND_SOC_QDSP6_APM_DAI=m
CONFIG_SND_SOC_QDSP6_APM_LPASS_DAI=m
CONFIG_SND_SOC_QDSP6_COMMON=m
CONFIG_SND_SOC_QDSP6_PRM=m
CONFIG_SND_SOC_QDSP6_PRM_LPASS_CLOCKS=m
CONFIG_SND_SOC_SC8280XP=m
CONFIG_SOUNDWIRE=m
CONFIG_SOUNDWIRE_QCOM=m
CONFIG_SPI_QCOM_GENI=m
CONFIG_SPI_QCOM_QSPI=m
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_VIDEO_QCOM_CAMSS=m
CONFIG_VIDEO_QCOM_IRIS=m

# Display: RA620 DP-to-HDMI bridge and HDMI connector
CONFIG_DRM_DISPLAY_CONNECTOR=m
CONFIG_DRM_SIMPLE_BRIDGE=m

# SD card, power key, LEDs
CONFIG_INPUT_PM8941_PWRKEY=m
CONFIG_LEDS_GPIO=m

# Audio: WCD9385 codec on SoundWire, LPASS macros
CONFIG_SND_SOC_WCD938X=m
CONFIG_SND_SOC_WCD938X_SDW=m

# Ethernet (RTL8111K on PCIe)
CONFIG_R8169=m
CONFIG_REALTEK_PHY=m

# Bluetooth (AIC8800D80 on USB, standard HCI class)
CONFIG_BT_HCIBTUSB=m

# USB hub on the board (Terminus FE1.1s)
CONFIG_USB_ONBOARD_DEV=m

# USB modems (Fibocom FM350-GL and others)
CONFIG_USB_NET_CDC_MBIM=m
CONFIG_USB_NET_QMI_WWAN=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_SERIAL_OPTION=m
CONFIG_USB_SERIAL_WWAN=m
CONFIG_USB_WDM=m

# PMIC RTC
CONFIG_RTC_DRV_PM8XXX=m

# Firmware from linux-firmware is compressed
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
