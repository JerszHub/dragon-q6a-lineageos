#
# Board specific kernel options for Radxa Dragon Q6A (QCS6490).
#
# The values below match the vendor kernel that is known to boot on this board.
# Each one is listed with the reason it is set, so that they can be re-evaluated
# individually once the board boots.

# 48-bit virtual addressing. The vendor kernel that boots on this board uses 48,
# the upstream default for this kernel is 52 and the Android GKI/Debian derived
# configuration selects 39. 39 is the outlier of the three.
CONFIG_ARM64_VA_BITS_48=y

# Branch Target Identification for kernel text. Not enabled by the vendor kernel.
# Disabled here while the board does not boot, to keep the early boot path as
# close as possible to the known working configuration.
# CONFIG_ARM64_BTI_KERNEL is not set

# Shadow call stack reserves x18, which is also the platform register in the
# UEFI calling convention. Not enabled by the vendor kernel either.
# CONFIG_SHADOW_CALL_STACK is not set

# Large System Extensions atomics, enabled by the vendor kernel. Performance
# only, kept for parity.
CONFIG_ARM64_LSE_ATOMICS=y

# NLS tables needed to mount the FAT EFI system partition, built in rather than
# modular. The android dir installation method keeps the kernel, the ramdisk and
# the system images on that partition, so mounting it is on the critical boot
# path. As modules they are unreachable at that point: the FAT driver asks the
# kernel to load nls_cp437 through request_module(), which runs the helper named
# by sysctl.kernel.modprobe. That helper is /vendor/bin/modprobe_kernel, and
# /vendor lives on the very partition being mounted. The result is
# "FAT-fs (mmcblk1p1): codepage cp437 not found" and the android dir is never
# found, ending in "CanQuitUeventd: Missing block device for android dir".
# CONFIG_FAT_DEFAULT_CODEPAGE is 437 and CONFIG_FAT_DEFAULT_IOCHARSET is "ascii".
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ASCII=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
