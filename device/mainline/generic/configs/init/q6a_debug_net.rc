#
# LOCAL DEBUG AID for the Radxa Dragon Q6A bring up. NOT upstream material.
#
# It exists so that a board whose framework never finishes coming up is still reachable
# over adb. Nothing configures the network before system_server runs, so adb over TCP is
# unreachable even when adbd itself is alive.
#
# docs/debugging.md describes doing this by hand from a serial console, but reaching a
# shell that way was never established on this board, so the commands have to be baked in.
# Remove this file once the framework comes up reliably on its own.

on property:sys.usb.ffs.ready=*
    start q6a_debug_net

on nonencrypted
    start q6a_debug_net

on property:init.svc.adbd=running
    start q6a_debug_net

service q6a_debug_net /system/bin/sh /vendor/bin/q6a_debug_net.sh
    class core
    user root
    group root
    # Not oneshot: the script keeps watching the configuration for about four minutes.
    disabled
    seclabel u:r:su:s0
