#
# Q6A: install user-supplied Google Apps. See q6a_install_gapps.sh.
#
# exec_start for the same reason as q6a_expand_userdata: the script reboots the board, and
# an asynchronous start would drop that reboot into the middle of whatever else post-fs-data
# has just begun. Parse order puts it after q6a_expand_userdata, so /data is already full
# size by the time the images are built on it.
on post-fs-data
    exec_start q6a_install_gapps

service q6a_install_gapps /system/bin/sh /vendor/bin/q6a_install_gapps.sh
    class core
    user root
    group root
    oneshot
    disabled
    seclabel u:r:su:s0
