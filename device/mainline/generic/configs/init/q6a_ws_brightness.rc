#
# Q6A: brightness of the WaveShare 7" HDMI LCD (C) from Android's slider. The panel takes
# brightness over USB HID, not through a backlight driver; see q6a_ws_brightness.sh.
# Without the panel the service only checks for it every few seconds.

on post-fs-data
    mkdir /data/vendor/q6a_ws_brightness 0700 root root

on property:sys.boot_completed=1
    start q6a_ws_brightness

service q6a_ws_brightness /system/bin/sh /vendor/bin/q6a_ws_brightness.sh
    class late_start
    user root
    group root
    disabled
    seclabel u:r:su:s0
