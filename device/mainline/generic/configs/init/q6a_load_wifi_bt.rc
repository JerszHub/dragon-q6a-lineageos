#
# Q6A: loads the AIC8800D80 drivers (Wi-Fi + Bluetooth) once /vendor is mounted.
# The detail and the reasoning are in q6a_load_wifi_bt.sh.

on post-fs-data
    start q6a_load_wifi_bt

service q6a_load_wifi_bt /system/bin/sh /vendor/bin/q6a_load_wifi_bt.sh
    class core
    user root
    group root
    oneshot
    disabled
    seclabel u:r:su:s0
